            "path": "src/custom-tab-bar/style.module.less",
            "content": ".tabBar {\r\n  width: 375px;\r\n  background: #ffffff;\r\n  box-shadow: 0px 4px 10px 0px rgba(0, 0, 0, 0.1);\r\n  z-index: 9999;\r\n\r\n  .items {\r\n    width: 375px;\r\n    height: 54px;\r\n    display: flex;\r\n  }\r\n\r\n  .safearea {\r\n    width: 375px;\r\n    height: constant(safe-area-inset-bottom);\r\n    height: env(safe-area-inset-bottom);\r\n  }\r\n\r\n  .item {\r\n    position: relative;\r\n    flex: 1;\r\n    height: 100%;\r\n    padding-top: 6px;\r\n    padding-bottom: 6px;\r\n\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    .iconSlot {\r\n      position: relative;\r\n      .fontIcon {\r\n        display: block;\r\n      }\r\n\r\n      .badge {\r\n        position: absolute;\r\n\r\n        transform-origin: 100% 0%;\r\n        transform: translate(50%, -40%);\r\n\r\n        top: 0px;\r\n        right: 0px;\r\n\r\n        background-color: #ff4d4f;\r\n      }\r\n      .badge.normal {\r\n        padding: 0px 3px;\r\n        min-width: 14px;\r\n        height: 14px;\r\n        border-radius: 100px;\r\n        font-size: 10px;\r\n\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        color: #fff;\r\n      }\r\n      .badge.small {\r\n        width: 9px;\r\n        height: 9px;\r\n        border-radius: 50%;\r\n      }\r\n    }\r\n\r\n    .textSlot {\r\n      margin-top: 6px;\r\n      height: 14px;\r\n    }\r\n  }\r\n}\r\n"
