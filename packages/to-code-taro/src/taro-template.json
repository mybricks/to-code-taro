        "content": "/* 隐藏 React Refresh 的全屏错误遮罩 */\r\n#react-refresh-overlay,\r\niframe[id='react-refresh-overlay'] {\r\n  display: none !important;\r\n}\r\n\r\n.mybricks_taro_systemPage {\r\n  height: 100vh !important;\r\n}\r\n\r\n.mybricks_com {\r\n  flex-shrink: 0;\r\n  min-height: 0; /* 防止子元素撑开父元素 */\r\n}\r\n.mybricks_slot {\r\n  width: 100%;\r\n  height: 100%;\r\n  position: relative;\r\n  transform: translateX(0);\r\n}\r\n\r\nview {\r\n  box-sizing: border-box;\r\n}\r\n"
