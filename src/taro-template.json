                "path": "src/core/mybricks/utils.js",
                "content": "export const safeSetByPath = (params) => {\n  const { data, path, value } = params;\n  const nextIndex = path.length - 1;\n  let current = data;\n  let errorFlag = false;\n  for (let i = 0; i < nextIndex; i++) {\n    try {\n      current = current[path[i]];\n    } catch (error) {\n      errorFlag = true;\n      break;\n    }\n  }\n\n  if (!errorFlag) {\n    current[path[nextIndex]] = value;\n  }\n}\n\nexport const safeGetByPath = (params) => {\n  const { data, path } = params;\n  let current = data;\n  let errorFlag = false;\n  for (let i = 0; i < path.length; i++) {\n    try {\n      current = current[path[i]];\n    } catch (error) {\n      errorFlag = true;\n      break;\n    }\n  }\n\n  if (!errorFlag) {\n    return current;\n  }\n\n  return undefined;\n}\n\nexport const isObject = (value) => {\n  return value && typeof value === \"object\";\n}\n\n"
              },
