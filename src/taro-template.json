              {
                "path": "src/components/formLocation/runtime.tsx",
                "content": "import React, { useState, useCallback, useMemo, useEffect } from \"react\";\nimport { View } from \"@tarojs/components\";\nimport cx from \"classnames\";\nimport { ArrowRight } from \"@taroify/icons\";\nimport { Field, Input, AreaPicker } from \"brickd-mobile\";\nimport { isObject, isString, isEmpty } from \"./../utils/core/type\";\nimport css from \"./style.less\";\nimport * as Taro from \"@tarojs/taro\";\nimport InputDisplay from \"../components/input-display\";\nimport useFormItemValue from \"../utils/hooks/useFormItemValue.ts\";\n\nexport default function (props) {\n  const { env, data, inputs, outputs, slots, parentSlot } = props;\n\n  const [value, setValue, getValue] = useFormItemValue(data.value, (val) => {\n    parentSlot?._inputs[\"onChange\"]?.({\n      id: props.id,\n      name: props.name,\n      value: val,\n    });\n\n    outputs[\"onChange\"](val);\n  });\n\n  useEffect(() => {\n    parentSlot?._inputs[\"setProps\"]?.({\n      id: props.id,\n      name: props.name,\n      value: {\n        visible: props.style.display !== \"none\",\n      },\n    });\n  }, [props.style.display]);\n\n  const isRelEnv = useMemo(() => {\n    if (env.runtime.debug || env.edit) {\n      return false;\n    } else {\n      return true;\n    }\n  }, [env]);\n\n  useEffect(() => {\n    //\n    inputs[\"setValue\"]((val) => {\n      switch (true) {\n        case isEmpty(val): {\n          data.value = [];\n          break;\n        }\n        case isString(val):\n          data.value = [val];\n          break;\n        case Array.isArray(val):\n          data.value = val;\n          break;\n        case isObject(val):\n          data.value = val[data.name];\n          break;\n        default:\n          break;\n      }\n    });\n\n    inputs[\"getValue\"]((val, outputRels) => {\n      outputRels[\"returnValue\"](data.value);\n    });\n\n    /* 设置禁用 */\n    inputs[\"setDisabled\"]?.((val, outputRels) => {\n      data.disabled = !!val;\n      outputRels[\"setDisabledComplete\"]?.(data.disabled);\n    });\n  }, []);\n\n  const onChange = useCallback((val) => {\n    data.value = val;\n    // parentSlot?._inputs[\"onChange\"]?.({\n    //   id: props.id,\n    //   name: props.name,\n    //   value: val,\n    // });\n    // outputs[\"onChange\"](val);\n  }, []);\n\n  useEffect(() => {\n    setValue(data.value);\n  }, [data.value]);\n\n  const toast = useCallback(() => {\n    if (env.runtime.debug) {\n      Taro.showToast({\n        title: \"地区选择仅支持小程序真机端\",\n        icon: \"none\",\n        duration: 1000,\n      });\n    }\n  }, [env]);\n\n  const $view = useMemo(() => {\n    if (isRelEnv) {\n      //真机运行态\n      return (\n        <AreaPicker\n          readonly={data.disabled}\n          disabled={data.disabled}\n          level={data.level}\n          value={value}\n          onChange={onChange}\n        >\n          {/* 非插槽视图 */}\n          {!data.isSlot && (\n            <View className={css.select}>\n              <Input\n                readonly\n                // disabled={true}\n                placeholder={data.placeholder}\n                value={value.join(\"/\")}\n                style={{ flex: 1 }}\n              />\n              <ArrowRight />\n            </View>\n          )}\n          {/* 插槽视图 */}\n          {data.isSlot && (\n            <View className={css.slot_style}>\n              {slots?.[\"content\"]?.render({\n                style: {\n                  // position: \"smart\",\n                  height: \"100%\",\n                },\n              })}\n            </View>\n          )}\n        </AreaPicker>\n      );\n    } else {\n      //调试态\n      return (\n        <View>\n          {/* 非插槽视图 */}\n          {!data.isSlot && (\n            <View\n              className={cx(css.select,\"mybricks-display\")}\n              onClick={() => {\n                toast();\n              }}\n            >\n              <InputDisplay\n                placeholder={data.placeholder}\n                value={value.join(\"/\")}\n              ></InputDisplay>\n              <ArrowRight />\n            </View>\n          )}\n          {/* 插槽视图 */}\n          {data.isSlot && (\n            <View\n              className={css.slot_style}\n              onClick={() => {\n                toast();\n              }}\n            >\n              {slots?.[\"content\"]?.render({\n                style: {\n                  // position: \"smart\",\n                  height: \"100%\",\n                },\n              })}\n            </View>\n          )}\n        </View>\n      );\n    }\n  }, [value, data.placeholder, isRelEnv, env, data.isSlot]);\n\n  return (\n    <View\n      className={cx({\n        [css.wrap]: true,\n        \"mybricks-formLocation\": true,\n        [css.slot_style]: data.isSlot,\n      })}\n    >\n      {$view}\n    </View>\n  );\n}\n"
              },
              {
                "path": "src/components/formLocation/style.less",
                "content": ".wrap {\n  width: 100%;\n}\n\n.select {\n  display: flex;\n  align-items: center;\n  width: 100%;\n}\n\n.slot_style{\n  width: 100%;\n  height: 100%;\n}"
              }
            ]
          },
          {
            "path": "src/components/formPassword",
            "content": null,
            "children": [
              {
                "path": "src/components/formPassword/ai.ts",
                "content": "\nexport default {\n  ':root' ({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: '密码输入框',\n    usage: `data声明\nlabel: string = \"密码输入\"\nname: string = \"密码输入\"\nplaceholder: string = \"请输入密码\"\n\nschema=mybricks.taro.formContainer/formItem\n\nstyleAry声明\n输入框:\n  - 默认样式:\n    - border: none\n  - 可编辑样式: \n    - 无（非必要不加边框，不然会有割裂感）\n内容文本:\n  - 默认样式:\n    - color: #323233\n    - textAlign: left\n    - fontSize: 14px\n  - 可编辑样式: color、fontSize、textAlign\n提示文本:\n  - 默认样式: \n    - color: #c0c0c0\n  - 可编辑样式: color、fontSize\n\nlayout声明\nwidth: 可配置\nheight: 不可配置，默认为fit-content`\n  },\n  modifyTptJson: (component) => {\n    component.style?.styleAry?.forEach?.((style, index) => {\n      if (style.selector === \".input\") {\n        style.selector = [\".mybricks-password\", \".mybricks-h5Password\"]\n      }\n      if (style.selector === \".text\") {\n        style.selector = [`.mybricks-password .taroify-input`, `.mybricks-h5Password .taroify-input .taroify-native-input`]\n      }\n      if (style.selector === \".placeholder\") {\n        style.selector = [`.mybricks-password .taroify-input__placeholder`, `.mybricks-h5Password .taroify-native-input::placeholder`]\n      }\n    })\n  }\n}"
              },
              {
                "path": "src/components/formPassword/com.json",
                "content": "{\n  \"title\": \"密码框\",\n  \"namespace\": \"mybricks.taro.formPassword\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.1\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/z3F28IuytjG2J6EtY8fAMIinoXfpeVVN-1743576944545.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置密码框的值，并触发值变化事件输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取密码框的值并输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空密码框的值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setPlaceholder\",\n      \"title\": \"设置提示内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onBlur\",\n      \"title\": \"当失去焦点\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
              {
                "path": "src/components/formPassword/data.json",
                "content": "{\n  \"label\": \"密码输入\",\n  \"name\": \"密码输入\",\n  \"placeholder\": \"请输入密码\",\n  \"type\": \"text\",\n  \"maxlength\": 20\n}"
              },
              {
                "path": "src/components/formPassword/editors.tsx",
                "content": "export default {\n  \"@init\": ({ style, data }) => {\n    style.width = \"100%\";\n    style.height = \"auto\";\n  },\n  \"@resize\": {\n    options: [\"width\"],\n  },\n\n  \":root\": {\n    style: [\n      {\n        title: \"输入框\",\n        options: [\"border\", \"size\", \"padding\", \"background\"],\n        target({ id }) {\n          return [\".mybricks-password\", \".mybricks-h5Password\"];\n        },\n      },\n      {\n        title: \"内容文本\",\n        options: [\"font\"],\n        target({ id }) {\n          return [\n            `.mybricks-password .taroify-input`,\n            `.mybricks-h5Password .taroify-input .taroify-native-input`,\n          ];\n        },\n      },\n      {\n        title: \"提示内容文本\",\n        options: [\"font\"],\n        target({ id }) {\n          return [\n            `.mybricks-password .taroify-input__placeholder`,\n            `.mybricks-h5Password .taroify-native-input::placeholder`,\n          ];\n        },\n      },\n    ],\n    items({ data, output, style }, cate0, cate1, cate2) {\n      cate0.title = \"密码框\";\n      cate0.items = [\n        {\n          title: \"基础属性\",\n          items: [\n            {\n              title: \"提示内容\",\n              description: \"该提示内容会在值为空时显示\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.placeholder;\n                },\n                set({ data }, value) {\n                  data.placeholder = value;\n                },\n              },\n            },\n            {\n              title: \"最大输入长度\",\n              description: \"密码输入框最大输入长度\",\n              type: \"number\",\n              value: {\n                get({ data }) {\n                  return data.maxlength || 20;\n                },\n                set({ data }, value) {\n                  data.maxlength = value;\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"事件\",\n          items: [\n            {\n              title: \"当值变化\",\n              type: \"_event\",\n              options: {\n                outputId: \"onChange\",\n              },\n            },\n            {\n              title: \"当失去焦点\",\n              type: \"_event\",\n              options: {\n                outputId: \"onBlur\",\n              },\n            },\n          ],\n        },\n      ];\n    },\n  },\n};\n"
              },
