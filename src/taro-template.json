                "content": "{\n  \"title\": \"富文本\",\n  \"namespace\": \"mybricks.taro.richText\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setDataSource\",\n      \"title\": \"设置内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    }\n  ]\n}\n"
