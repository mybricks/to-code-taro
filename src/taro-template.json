                    "content": "img[src=\"\"] {\n  opacity: 0;\n}\n\n.h5-img {\n  display: inline-block;\n  overflow: hidden;\n  position: relative;\n  font-size: 0;\n  width: 320px;\n  height: 240px;\n}\n\n.h5-img.h5-img__widthfix {\n  height: 100%;\n}\n\n.h5-img__mode-scaletofill {\n  // object-fit: contain;\n  width: 100%;\n  height: 100%;\n}\n\n.h5-img__mode-aspectfit {\n  object-fit: contain;\n  width: 100%;\n  height: 100%;\n}\n\n.h5-img__mode-aspectfill {\n  object-fit: cover;\n  width: 100%;\n  height: 100%;\n}\n\n.h5-img__mode-widthfix {\n  width: 100%;\n}\n\n.h5-img__mode-top {\n  width: 100%;\n}\n\n.h5-img__mode-bottom {\n  width: 100%;\n  position: absolute;\n  bottom: 0;\n}\n\n.h5-img__mode-left {\n  height: 100%;\n}\n\n.h5-img__mode-right {\n  position: absolute;\n  height: 100%;\n  right: 0;\n}\n\n.h5-img__mode-topright {\n  position: absolute;\n  right: 0;\n}\n\n.h5-img__mode-bottomleft {\n  position: absolute;\n  bottom: 0;\n}\n\n.h5-img__mode-bottomright {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n}"
