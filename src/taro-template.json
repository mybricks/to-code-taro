                    "content": "<?xml version=\"1.0\" standalone=\"no\"?><!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\"><svg t=\"1717577370129\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"4284\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"128\" height=\"128\"><path d=\"M838.487 283.51c5.077-5.077 11.17-11.17 14.725-17.771 28.434-35.543 31.988-88.858 8.124-127.955-23.865-39.097-59.915-58.9-106.121-58.9H181.45c-11.17 0-22.849 0-32.496 3.047-24.372 6.093-46.714 20.31-62.962 40.62-16.756 20.819-25.895 46.714-25.895 72.102 0 33.512 12.694 63.47 36.05 83.78 73.625 71.085 147.25 144.71 218.843 216.303v237.122c4.062 30.973 27.419 47.73 55.853 35.543h0.508c15.232-7.616 24.372-23.357 24.372-42.651V483.058c0-16.248-5.078-29.45-14.725-39.605-35.543-35.543-70.578-72.609-104.598-108.66-35.035-37.066-71.085-75.147-109.167-112.721l-2.03-1.524-2.032-1.015c-0.508-0.508-1.523-2.031-2.539-3.047-1.015-1.015-2.03-2.538-3.046-3.554-6.601-8.124-8.124-15.233-5.078-24.88 5.078-12.186 15.74-25.895 28.942-25.895h578.841c7.109 0 13.71 4.062 19.295 10.662 7.109 9.14 9.647 20.818 6.6 31.481-1.522 5.586-4.061 8.124-11.17 15.74-79.717 76.672-155.88 152.835-236.614 233.568l-0.507 0.508c-8.125 8.124-17.772 19.802-17.772 39.605v406.712c0 5.077 0 19.295 10.155 30.465 0 0 3.047 7.109 16.756 12.186 16.756 6.093 33.004-1.015 33.004-1.015l4.062-3.047c16.756-12.694 16.756-31.988 16.756-43.667v-384.37c40.113-39.605 81.241-78.703 121.354-115.769 41.128-38.59 79.21-74.64 116.276-111.706z m88.857 520.957H708.5c-22.849 0-36.558 18.787-36.558 36.559v10.155c0 22.849 18.787 36.558 36.558 36.558h218.843c22.849 0 36.558-18.787 36.558-36.558v-10.155c0-21.834-14.217-36.559-36.558-36.559z m0-131.509H708.5c-22.849 0-36.558 18.787-36.558 36.559v7.616c0 22.85 18.787 36.559 36.558 36.559h218.843c22.849 0 36.558-18.787 36.558-36.559v-7.616c0-17.772-13.201-36.559-36.558-36.559z m0-125.923H708.5c-22.849 0-3