                "content": "export default {\n  \"@init\"({ style }) {\n    style.width = \"100%\";\n  },\n  \":root\"({ data, output, style }, cate0, cate1, cate2) {\n    cate0.title = \"常规\";\n    cate0.items = [\n      {\n        title: \"安全区的位置\",\n        type: \"select\",\n        options: [\n          {\n            label: \"顶部\",\n            value: \"top\",\n          },\n          {\n            label: \"底部\",\n            value: \"bottom\",\n          },\n        ],\n        value: {\n          get({ data }) {\n            return data.position;\n          },\n          set({ data }, value) {\n            data.position = value;\n          },\n        },\n      },\n    ];\n  },\n};\n"
