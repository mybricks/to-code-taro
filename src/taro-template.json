                          {
                            "path": "src/components/taroAi/editors/knowledges/f2/area.md",
                            "content": "## 基础面积图示例代码\n\n```jsx file=\"runtime.jsx\"\nimport { comDef } from 'mybricks';\nimport { useEffect, useState } from 'react';\nimport css from 'style.less';\nimport { View } from \"@tarojs/components\";\nimport { Area } from \"f2-for-taro\";\n\nexport default comDef(({ data, env, inputs, outputs, slots }) => {\n  const [chart, setChart] = useState(null);\n\n  useEffect(() => {\n    if (!chart) {\n      return;\n    }\n\n    chart.clear();\n\n    const data = [{\n      time: 'Jan.',\n      tem: 1000\n    }, {\n      time: 'Feb.',\n      tem: 2200\n    }, {\n      time: 'Mar.',\n      tem: 2000\n    }];\n\n    chart.source(data);\n    chart.area().position('time*tem');\n    chart.line().position('time*tem');\n    chart.render();\n\n  }, [chart, data.dataSource]);\n\n  return (\n    <View className={css.myChart}>\n      <Area env={env} onInit={(ref) => setChart(ref)} />\n    </View>\n  );\n}, {\n  type: \"main\"\n  title: \"组件\",\n});\n```\n\n```less file=\"style.less\"\n.canvas{\n  width: 100%;\n  height: 100%;\n}\n```\n"
                          },
                          {
                            "path": "src/components/taroAi/editors/knowledges/f2/area.ts",
                            "content": "export default {\n  description: `面积图组件`,\n  editors: {},\n  docs: require(\"./area.md\").default,\n};\n"
                          },
                          {
                            "path": "src/components/taroAi/editors/knowledges/f2/bar.md",
                            "content": "## 基础条形图示例代码\n```jsx file=\"runtime.jsx\"\nimport { comDef } from 'mybricks';\nimport { useEffect, useState } from 'react';\nimport css from 'style.less';\nimport { View } from \"@tarojs/components\";\nimport { Bar } from \"f2-for-taro\";\n\nexport default comDef(({ data, env, inputs, outputs, slots }) => {\n  const [chart, setChart] = useState(null);\n\n  useEffect(() => {\n    if (!chart) {\n      return;\n    }\n\n    chart.clear();\n\n    const data = [{\n      year: '1951 年',\n      sales: 38\n    }, {\n      year: '1952 年',\n      sales: 52\n    }];\n\n    chart.source(data, {\n      sales: {\n        tickCount: 5\n      }\n    });\n    chart.coord({\n      transposed: true\n    });\n    chart.interval().position('year*sales');\n    chart.render();\n\n\n  }, [chart, data.dataSource]);\n\n  return (\n    <View className={css.myChart}>\n      <Bar env={env} onInit={(ref) => setChart(ref)} />\n    </View>\n  );\n}, {\n  type: \"main\"\n  title: \"组件\",\n});\n```\n\n```less file=\"style.less\"\n.canvas{\n  width: 100%;\n  height: 100%;\n}\n```"
                          },
                          {
                            "path": "src/components/taroAi/editors/knowledges/f2/bar.ts",
