.982223-3.470222-2.275556-6.428444-5.290666-3.015111-2.958222-5.347556-6.428445-2.275556-3.527111-3.925333-7.395555-1.592889-3.868444-2.446223-7.964445Q256 686.819556 256 682.666667t0.796444-8.305778q0.853333-4.152889 2.446223-8.021333 1.592889-3.868444 3.982222-7.395556 2.275556-3.470222 5.290667-6.428444 2.958222-3.015111 6.428444-5.347556 3.527111-2.275556 7.395556-3.925333 3.868444-1.592889 7.964444-2.446223 4.152889-0.796444 8.362667-0.796444t8.305777 0.796444q4.152889 0.853333 8.021334 2.446223 3.868444 1.592889 7.395555 3.982222 3.470222 2.275556 6.428445 5.290667 3.015111 2.958222 5.347555 6.428444 2.275556 3.527111 3.925334 7.395556 1.592889 3.868444 2.446222 7.964444Q341.333333 678.513778 341.333333 682.666667z m-42.666666 0q0 4.209778-0.796445 8.305777-0.853333 4.152889-2.446222 8.021334-1.592889 3.868444-3.982222 7.395555-2.275556 3.470222-5.290667 6.428445-2.958222 3.015111-6.428444 5.347555-3.527111 2.275556-7.395556 3.925334-3.868444 1.592889-7.964444 2.446222-4.152889 0.796444-8.362667 0.796444t-8.305778-0.796444q-4.152889-0.853333-8.021333-2.446222-3.868444-1.592889-7.395556-3.982223-3.470222-2.275556-6.428444-5.290666-3.015111-2.958222-5.347556-6.428445-2.275556-3.527111-3.925333-7.395555-1.592889-3.868444-2.446222-7.964445-0.796444-4.152889-0.796445-8.362666t0.796445-8.305778q0.853333-4.152889 2.446222-8.021333 1.592889-3.868444 3.982222-7.395556 2.275556-3.470222 5.290667-6.428444 2.958222-3.015111 6.428444-5.347556 3.527111-2.275556 7.395556-3.925333 3.868444-1.592889 7.964444-2.446223 4.152889-0.796444 8.362667-0.796444t8.305778 0.796444q4.152889 0.853333 8.021333 2.446223 3.868444 1.592889 7.395556 3.982222 3.470222 2.275556 6.428444 5.290667 3.015111 2.958222 5.347556 6.428444 2.275556 3.527111 3.925333 7.395556 1.592889 3.868444 2.446222 7.964444 0.796444 4.152889 0.796445 8.362667z\" fill=\"#515151\" p-id=\"12796\" data-spm-anchor-id=\"a313x.search_index.0.i25.1c903a81jYIaKl\" class=\"selected\"></path></svg>"
