                "path": "src/components/containerAbs/com.json",
                "content": "{\n  \"title\": \"自由布局\",\n  \"namespace\": \"mybricks.taro.containerAbs\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"description\": \"允许在内部自由拖动子元素的布局\",\n  \"runtime\": \"./runtime.tsx\",\n  \"runtime.edit\": \"./edit/runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"slots\": [\n    {\n      \"id\": \"content\",\n      \"title\": \"将组件拖拽到这里，通过拖拽调整位置\",\n      \"layout\": \"absolute\"\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"click\",\n      \"title\": \"点击\"\n    }\n  ]\n}"
