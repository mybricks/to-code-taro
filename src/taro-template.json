                "path": "src/components/formInput/runtime.tsx",
                "content": "import React, { useState, useCallback, useEffect, useMemo } from \"react\";\nimport { isNumber, isObject, isString, isEmpty } from \"../utils/type\";\nimport useFormItemValue from \"../utils/hooks/useFormItemValue.ts\";\nimport { Input,Image } from \"brickd-mobile\";\nimport { View } from \"@tarojs/components\";\nimport css from \"./style.less\";\nimport { isH5 } from \"../utils/env\";\nimport cx from \"classnames\";\nimport { clearable } from \"./clearable\";\n\nexport default function (props) {\n  const { env, data, inputs, outputs, slots, parentSlot } = props;\n\n  const [value, setValue, getValue] = useFormItemValue(data.value, (val) => {\n    //\n    parentSlot?._inputs[\"onChange\"]?.({\n      id: props.id,\n      name: props.name,\n      value: val,\n    });\n\n    //\n    outputs[\"onChange\"](val);\n  });\n\n  useEffect(() => {\n    parentSlot?._inputs[\"setProps\"]?.({\n      id: props.id,\n      name: props.name,\n      value: {\n        visible: props.style.display !== \"none\",\n      },\n    });\n  }, [props.style.display]);\n\n  useEffect(() => {\n    /* 设置值 */\n    inputs[\"setValue\"]((val, outputRels) => {\n      let result;\n\n      switch (true) {\n        case isEmpty(val): {\n          result = \"\";\n          break;\n        }\n        case isString(val) || isNumber(val): {\n          result = `${val}`;\n          break;\n        }\n        default:\n          // 其他类型的值，直接返回\n          return;\n      }\n\n      setValue(result);\n      outputRels[\"setValueComplete\"]?.(result); // 表单容器调用 setValue 时，没有 outputRels\n    });\n\n    /* 获取值 */\n    inputs[\"getValue\"]((val, outputRels) => {\n      outputRels[\"returnValue\"](getValue());\n    });\n\n    /* 重置值 */\n    inputs[\"resetValue\"]((val, outputRels) => {\n      setValue(\"\");\n      outputRels[\"resetValueComplete\"]?.(\"\");\n    });\n\n    /* 设置标题 */\n    inputs[\"setLabel\"]?.((val) => {\n      if (!isString(val)) {\n        return;\n      }\n\n      parentSlot?._inputs[\"setProps\"]?.({\n        id: props.id,\n        name: props.name,\n        value: {\n          label: val,\n        },\n      });\n    });\n\n    /* 设置提示内容 */\n    inputs[\"setPlaceholder\"]((val) => {\n      data.placeholder = val;\n    });\n\n    /* 设置禁用 */\n    inputs[\"setDisabled\"]?.((val, outputRels) => {\n      data.disabled = !!val;\n      outputRels[\"setDisabledComplete\"]?.(data.disabled);\n    });\n  }, []);\n\n  const onChange = useCallback((e) => {\n    let value = e.detail.value;\n    setValue(value);\n    outputs?.[\"onChange\"](value);\n  }, []);\n\n  const onBlur = useCallback((e) => {\n    let value = e.detail.value;\n    outputs?.[\"onBlur\"](value);\n  }, []);\n\n  const onConfirm = useCallback((e) => {\n    let value = e.detail.value;\n    outputs?.[\"onConfirm\"](value);\n  }, []);\n\n  const $showCount = useMemo(() => {\n    if (data.showCount) {\n      return (\n        <View className={css.showCount}>\n          {data.maxlength == -1\n            ? value.length\n            : `${value.length}/${data.maxlength}`}\n        </View>\n      );\n    } else {\n      return null;\n    }\n  }, [data.maxlength, data.showCount, value]);\n\n  const $clearIcon = useMemo(()=>{\n    if(data.clearable && value.length > 0){\n      return <View style={{width:18,height:18}} onClick={()=>{\n        setValue('')\n      }}>\n        <Image src={clearable}></Image>\n      </View>\n    }else{\n      return null\n    }\n  },[data.clearable,value.length])\n\n  return (\n    <View\n      className={cx({\n        [css.formItem]: true,\n        \"mybricks-formItem\": true,\n      })}\n    >\n      <Input\n        className={cx({\n          [css.input]: !isH5(),\n          \"mybricks-input\": !isH5(),\n          \"mybricks-h5Input\": isH5(),\n        })}\n        value={value}\n        type={data.type}\n        placeholder={data.placeholder}\n        align={data.inputAlign}\n        onChange={onChange}\n        disabled={data.disabled}\n        cursorSpacing={28}\n        cursor={value.length}\n        onBlur={onBlur}\n        maxlength={data.maxlength}\n        confirmType={\"done\"}\n        onConfirm={onConfirm}\n        clearable={false}\n      />\n      {$showCount}\n      {$clearIcon}\n    </View>\n  );\n}\n"
              },
              {
                "path": "src/components/formInput/style.less",
                "content": ".formItem {\n  display: flex;\n  align-items: center;\n  width: 100%;\n\n  .input {\n    color: #323233;\n    height: auto;\n  }\n\n  .showCount{\n    color:rgba(0, 0, 0, 0.45);\n    width: max-content;\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    letter-spacing: 2px;\n    font-size: 12px;\n    margin-left: 5px;\n  }\n}\n\n:global(.taroify-native-input){\n   // H5兼容，给input配置字体大小，不然不会编译成vw\n   font-size: 14px;\n   border: none;\n   background: transparent;\n   height: 100%;\n}\n\n:global(.taroify-input--disabled){\n  color: rgba(192,192,192,1) !important;\n}"
              }
            ]
          },
          {
            "path": "src/components/formItemContainer",
            "content": null,
            "children": [
              {
                "path": "src/components/formItemContainer/ai.ts",
                "content": "export default {\n  ':root'({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: `自定义表单项，内部支持渲染任意子元素来自定义UI，最终与formContainer通信完成表单信息的收集和渲染\n何时使用：仅在现有其他表单项UI不能满足用户需求时，用自定义表单项可以渲染特殊样式的UI，在formContainer被推荐时可以推荐。`,\n    usage: `自定义表单项，内部支持渲染任意子元素来自定义UI，最终与formContainer通信完成表单信息的收集和渲染\n何时使用：仅在现有其它表单项UI不能满足用户需求时，用自定义表单项可以渲染特殊样式的UI，代价是配置变复杂，非必要不使用。\n\n  schema=mybricks.taro.formContainer/formItem\n\n  slots插槽\n  formItem: 内容`\n  },\n  modifyTptJson: (component) => {\n \n  }\n}"
              },
              {
                "path": "src/components/formItemContainer/com.json",
                "content": "{\n  \"title\": \"自定义表单项\",\n  \"namespace\": \"mybricks.taro.formItemContainer\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"description\": \"自定义表单项的容器，支持拖入其他任意组件搭建组合表单项\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/t64W7x4jG01j8kyoWWb1EmK7plOSXbjp-1743580279531.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置表单项的值，用于校验和提交，并触发值变化事件输出\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"setValueDone\"]\n    },\n    {\n      \"id\": \"validate\",\n      \"title\": \"校验\",\n      \"desc\": \"触发表单项的校验检查，并输出校验结果\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"returnValidate\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取表单项的值并输出\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空表单项的值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueDone\"]\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置禁用\",\n      \"desc\": \"禁用自定义表单项，阻止用户交互\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"setDisabledDone\"]\n    },\n    {\n      \"id\": \"setEnabled\",\n      \"title\": \"设置启用\",\n      \"desc\": \"启用自定义表单项，允许用户交互\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"setEnabledDone\"]\n    },\n    {\n      \"id\": \"isEnable\",\n      \"title\": \"启用/禁用\",\n      \"desc\": \"根据输入值控制自定义表单项启用/禁用，true-启用，false-禁用\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      },\n      \"rels\": [\"isEnableDone\"]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onInitial\",\n      \"title\": \"值初始化\",\n      \"desc\": \"自定义表单项值初始化时触发，输出自定义表单项初始值\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"onChange\",\n      \"title\": \"值更新\",\n      \"desc\": \"自定义表单项值更新时触发，输出自定义表单项当前值\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"onValidate\",\n      \"title\": \"校验触发\",\n      \"desc\": \"自定义表单项校验时触发，输出自定义表单项当前值\",\n      \"schema\": {\n        \"title\": \"当前值\",\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"returnValidate\",\n      \"title\": \"校验结果\",\n      \"desc\": \"输出自定义表单项校验结果\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"validateStatus\": {\n            \"title\": \"校验状态\",\n            \"type\": \"string\",\n            \"description\": \"校验状态\"\n          },\n          \"help\": {\n            \"title\": \"校验提示\",\n            \"type\": \"string\",\n            \"description\": \"校验提示\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"desc\": \"输出自定义表单项当前值\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"setValueDone\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"resetValueDone\",\n      \"title\": \"重置完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"setDisabledDone\",\n      \"title\": \"禁用完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"setEnabledDone\",\n      \"title\": \"启用完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\": \"isEnableDone\",\n      \"title\": \"启用/禁用完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"setOptionsDone\",\n      \"title\": \"设置数据源输入完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"formItem\",\n      \"title\": \"自定义表单项\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"curValue\",\n          \"title\": \"设置值\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        }\n      ],\n      \"outputs\": [\n        {\n          \"id\": \"setCurValue\",\n          \"title\": \"设置表单项值\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        }\n      ]\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
