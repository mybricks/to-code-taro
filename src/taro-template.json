                "path": "src/components/formRate/runtime.tsx",
                "content": "import React, { useState, useCallback, useMemo, useEffect } from \"react\";\nimport { View } from \"@tarojs/components\";\nimport cx from \"classnames\";\nimport { isObject, isString, isNumber, isEmpty } from \"./../utils/core/type\";\nimport { Rate, Field } from \"brickd-mobile\";\n\nexport default function (props) {\n  const { env, data, inputs, outputs, slots, parentSlot } = props;\n  const [value, setValue] = useState(\"\");\n\n  useEffect(() => {\n    parentSlot?._inputs[\"setProps\"]?.({\n      id: props.id,\n      name: props.name,\n      value: {\n        visible: props.style.display !== \"none\",\n      },\n    });\n  }, [props.style.display]);\n\n  useEffect(() => {\n    inputs[\"setValue\"]((val) => {\n      switch (true) {\n        case isEmpty(val): {\n          setValue(\"\");\n          break;\n        }\n        case isString(val) || isNumber(val):\n          setValue(val);\n          break;\n        case isObject(val):\n          setValue(val[data.name]);\n          break;\n        default:\n          break;\n      }\n    });\n\n    /* 设置禁用 */\n    inputs[\"setDisabled\"]?.((val, outputRels) => {\n      data.disabled = !!val;\n      outputRels[\"setDisabledComplete\"]?.(data.disabled);\n    });\n  }, []);\n\n  const onChange = useCallback((value) => {\n    setValue(value);\n    parentSlot?._inputs[\"onChange\"]?.({\n      id: props.id,\n      name: props.name,\n      value,\n    });\n    outputs[\"onChange\"](value);\n  }, []);\n\n  return (\n    // <Field label={data.label} name={data.name}>\n    <Rate\n      value={value}\n      onChange={onChange}\n      count={data.count}\n      allowHalf={data.allowHalf}\n      disabled={data.disabled}\n    />\n    // </Field>\n  );\n}\n"
              }
            ]
          },
          {
            "path": "src/components/formSelect",
            "content": null,
            "children": [
              {
                "path": "src/components/formSelect/ai.ts",
                "content": "\nexport default {\n  ':root' ({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: '下拉选择，左侧文本 + 右侧右箭头组成，点击会弹出下拉选择picker',\n    usage: `下拉选择，左侧文本 + 右侧右箭头组成，点击会弹出下拉选择picker\n\nschema=mybricks.taro.formContainer/formItem\n\nstyleAry声明\n输入框:\n  - 默认样式:\n    - border: none\n  - 可编辑样式: \n    - 无（非必要不加边框，不然会有割裂感）\n内容文本:\n  - 默认样式:\n    - color: #323233\n    - textAlign: left\n    - fontSize: 14px\n  - 可编辑样式: color、fontSize、textAlign\n提示文本:\n  - 默认样式: \n    - color: #c0c0c0\n  - 可编辑样式: color、fontSize\n\n元素组成\n- 左侧：一个文本，为placeholder的内容\n- 右侧：一个右箭头图标\n\nlayout声明\nwidth: 可配置\nheight: 可配置，默认为fit-content`\n  },\n  modifyTptJson: (component) => {\n    component.style?.styleAry?.forEach?.((style, index) => {\n      if (style.selector === \".input\") {\n        style.selector = [\".mybricks-select\", \".mybricks-h5Select\"]\n      }\n      if (style.selector === \".text\") {\n        style.selector = `#a-${component?.id} .mybricks-input`\n      }\n      if (style.selector === \".placeholder\") {\n        style.selector = `#a-${component?.id} .mybricks-placeholder`\n      }\n    })\n  }\n}"
              },
              {
                "path": "src/components/formSelect/com.json",
                "content": "{\n  \"title\": \"下拉选择\",\n  \"namespace\": \"mybricks.taro.formSelect\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.1\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/Z78PPSllBRjatVgmTHvv0pgaFJwIR44z-1743578748453.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置表单项值\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取表单项值并输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空表单项值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setOptions\",\n      \"title\": \"设置下拉选项\",\n      \"schema\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"label\": {\n              \"title\": \"标签\",\n              \"type\": \"string\"\n            },\n            \"value\": {\n              \"title\": \"值\",\n              \"type\": \"string\"\n            },\n            \"disabled\": {\n              \"title\": \"禁用\",\n              \"type\": \"boolean\"\n            },\n            \"checked\": {\n              \"title\": \"默认选中\",\n              \"type\": \"boolean\"\n            }\n          }\n        }\n      },\n      \"rels\": [\"setOptionsComplete\"]\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onCancel\",\n      \"title\": \"取消选择或点遮罩层收起时\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setOptionsComplete\",\n      \"title\": \"选项设置完成\",\n      \"schema\": {\n        \"type\": \"array\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"content\",\n      \"title\": \"可点击插槽\"\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"],\n  \"connector\": {\n    \"schema\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}\n"
              },
              {
                "path": "src/components/formSelect/data.json",
                "content": "{\n  \"label\": \"下拉选择\",\n  \"name\": \"下拉选择\",\n  \"placeholder\": \"点击选择\",\n  \"value\": \"\",\n  \"options\": [\n    {\n      \"label\": \"公开\",\n      \"value\": \"公开\"\n    },\n    {\n      \"label\": \"仅好友可见\",\n      \"value\": \"仅好友可见\"\n    },\n    {\n      \"label\": \"保密\",\n      \"value\": \"保密\"\n    }\n  ],\n  \"arrow\": \"right\"\n}\n"
