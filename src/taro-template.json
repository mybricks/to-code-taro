              {
                "path": "src/components/cascader/com.json",
                "content": "{\n  \"title\": \"级联选择\",\n  \"namespace\": \"mybricks.taro.cascader\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"runtime.edit\": \"./runtime.edit.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"addDataSource\",\n      \"title\": \"级联数据\",\n      \"desc\": \"添加输入的级联数据\",\n      \"schema\": {\n        \"title\": \"级联数据\",\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"label\": {\n              \"title\": \"名称\",\n              \"desc\":\"名称\",\n              \"type\": \"string\"\n            },\n            \"value\": {\n              \"title\": \"值\",\n              \"desc\":\"值\",\n              \"type\": \"string\"\n            },\n            \"children\": {\n              \"title\": \"子级\",\n              \"desc\":\"子级\",\n              \"type\": \"array\"\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置的值，并触发值变化事件输出\",\n      \"schema\": {\n        \"title\": \"选中项数组\",\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      }\n    }\n  ],\n  \"slots\": [],\n  \"outputs\": [\n    {\n      \"id\": \"onSelect\",\n      \"title\": \"每当选择选项时\",\n      \"schema\": {\n        \"title\": \"选中项数组\",\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"label\": {\n              \"title\": \"名称\",\n              \"type\": \"string\"\n            },\n            \"value\": {\n              \"title\": \"值\",\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当选择完毕时\",\n      \"schema\": {\n        \"title\": \"选中项数组\",\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"label\": {\n              \"title\": \"名称\",\n              \"type\": \"string\"\n            },\n            \"value\": {\n              \"title\": \"值\",\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  ]\n}\n"
