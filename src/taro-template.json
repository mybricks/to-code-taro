                "path": "src/components/containerCondition/editors.less",
                "content": ".listItemBtn {\n  display: flex;\n  margin-left: 5px;\n  cursor: pointer;\n}\n\n.edit {\n  .listItemBtn();\n  margin-top: 3px;\n  margin-bottom: 3px;\n  height: 22px;\n  width: 22px;\n  align-items: center;\n  justify-content: center;\n  border-radius: 3px;\n  &:hover {\n    background-color: #ddd;\n  }\n}\n\n.my_edit{\n  display: flex;\n  align-items: center;\n  .selected_title{\n    font-size: 9px;\n    border: #FA6400 solid 1px;\n    border-radius: 20px;\n    color: white;\n    font-weight: 700;\n    background-color: #FA6400;\n    padding: 2px 4px;\n  }\n}"
