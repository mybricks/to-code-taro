                    "path": "src/components/containerGrid2/h5/com.json",
                    "content": "{\n  \"title\": \"布局\",\n  \"namespace\": \"mybricks.normal-h5.container-grid\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"description\": \"布局\",\n  \"runtime\": \"./runtime.tsx\",\n  \"runtime.edit\": \"./../edit/runtime.tsx\",\n  \"data\": \"./../data.json\",\n  \"editors\": \"./../editors.tsx\",\n  \"icon\": \"./../icon.svg\",\n  \"slots\": [\n    {\n      \"id\": \"default\",\n      \"title\": \"内容_default\"\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"click_layout\",\n      \"title\": \"点击\"\n    }\n  ]\n}\n"
