                "path": "src/components/groupCard/editors.tsx",
                "content": "export default {\n  '@init': ({ style, data }) => {\n    style.width = \"100%\";\n\n    style.marginTop = 12;\n    style.marginRight = 12;\n    style.marginBottom = 12;\n    style.marginLeft = 12;\n  },\n  ':root'({ data, output, style }, cate0, cate1, cate2) {\n    cate0.title = '常规';\n    cate0.items = [\n    ]\n\n    cate1.title = '样式';\n    cate1.items = [\n    ]\n\n    cate2.title = '动作';\n    cate2.items = [\n      {\n        title: '单击',\n        type: '_event',\n        options: {\n          outputId: 'onClick',\n        },\n      }\n    ]\n  }\n};\n"
