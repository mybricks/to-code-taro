                "path": "src/components/cascader/runtime.edit.tsx",
                "content": "import React, { useCallback, useMemo, useState } from \"react\";\nimport Runtime from './runtime'\n\n\nconst dept = [\n  {\n    label: \"浙江省\",\n    value: \"330000\",\n    children: [\n      {\n        label: \"杭州市\",\n        value: \"330100\",\n        children: [\n          {\n            label: \"上城区\",\n            value: \"330102\",\n          },\n          {\n            label: \"下城区\",\n            value: \"330103\",\n          },\n          {\n            label: \"江干区\",\n            value: \"330104\",\n          },\n        ],\n      },\n      {\n        label: \"宁波市\",\n        value: \"330200\",\n        children: [\n          {\n            label: \"海曙区\",\n            value: \"330203\",\n          },\n          {\n            label: \"江北区\",\n            value: \"330205\",\n          },\n          {\n            label: \"北仑区\",\n            value: \"330206\",\n          },\n        ],\n      },\n      {\n        label: \"温州市\",\n        value: \"330300\",\n        children: [\n          {\n            label: \"鹿城区\",\n            value: \"330302\",\n          },\n          {\n            label: \"龙湾区\",\n            value: \"330303\",\n          },\n          {\n            label: \"瓯海区\",\n            value: \"330304\",\n          },\n        ],\n      },\n    ],\n  },\n  {\n    label: \"江苏省\",\n    value: \"320000\",\n    children: [\n      {\n        label: \"南京市\",\n        value: \"320100\",\n        children: [\n          {\n            label: \"玄武区\",\n            value: \"320102\",\n          },\n          {\n            label: \"秦淮区\",\n            value: \"320104\",\n          },\n          {\n            label: \"建邺区\",\n            value: \"320105\",\n          },\n        ],\n      },\n      {\n        label: \"无锡市\",\n        value: \"320200\",\n        children: [\n          {\n            label: \"锡山区\",\n            value: \"320205\",\n          },\n          {\n            label: \"惠山区\",\n            value: \"320206\",\n          },\n          {\n            label: \"滨湖区\",\n            value: \"320211\",\n          },\n        ],\n      },\n      {\n        label: \"徐州市\",\n        value: \"320300\",\n        children: [\n          {\n            label: \"鼓楼区\",\n            value: \"320302\",\n          },\n          {\n            label: \"云龙区\",\n            value: \"320303\",\n          },\n          {\n            label: \"贾汪区\",\n            value: \"320305\",\n          },\n        ],\n      },\n    ],\n  },\n]\n\n\nexport default function (props) {\n  return (\n    <Runtime\n      {...props}\n      mockProps={{\n        value: ['330000', '330100', '330102'],\n        options: dept,\n      }}\n    />\n  );\n}\n"
