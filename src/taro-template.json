              {
                "path": "src/components/containerList/ai.ts",
                "content": "export default {\n  ':root' ({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: `列表容器，循环列表组件，用于动态数据列表的实现，支持横排和竖排展示。\n何时使用：对需求思考一下，当考虑需要用动态列表的时候，使用此组件，否则使用多个重复的组件来搭建静态列表。`,\n    usage: `列表容器，循环列表组件，用于动态数据列表的实现，支持横排和竖排展示。\n何时使用：对需求思考一下，当考虑需要用动态列表的时候，使用此组件，否则使用多个重复的组件来搭建静态列表。\n\nslots插槽\nitem # 列表项插槽\n\nlayout声明\nwidth: 可配置\nheight: 不可配置，默认为fit-content\n\n注意事项\n- 在列表中，插槽仅放置一个组件即可，因为列表会遍历这个组件，不要开发多个，仅需开发一个示例即可；\n- 对于静态数据的列表，不要使用循环列表，用基础组件开发多个示例；\n- 对于内部组件的内容，不允许使用{}、{{}}这类绑定语法；`\n  }\n}"
              },
              {
                "path": "src/components/containerList/com.json",
                "content": "{\n  \"title\": \"循环列表\",\n  \"namespace\": \"mybricks.taro.containerList\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"runtime.edit\": \"./edit/runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"refreshDataSource\",\n      \"title\": \"覆盖数据\",\n      \"desc\": \"列表已有的数据也会被覆盖\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"array\",\n        \"items\": {\n          \"title\": \"列项数据\",\n          \"type\": \"any\"\n        }\n      }\n    },\n    {\n      \"id\": \"addDataSource\",\n      \"title\": \"添加数据\",\n      \"desc\": \"在列表数据的末尾插入添加的数据\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"array\",\n        \"items\": {\n          \"title\": \"列项数据\",\n          \"type\": \"any\"\n        }\n      }\n    },\n    {\n      \"id\": \"getDataSource\",\n      \"title\": \"获取数据\",\n      \"desc\": \"获取列表数据\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"getDataSourceSuccess\"]\n    },\n    {\n      \"id\": \"loading\",\n      \"title\": \"切换到加载中\",\n      \"desc\": \"提示用户正在加载中\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"noMore\",\n      \"title\": \"切换到加载完毕\",\n      \"desc\": \"提示用户已经没有数据了\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"error\",\n      \"title\": \"切换到加载报错\",\n      \"desc\": \"提示用户报错信息\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\":\"empty\",\n      \"title\":\"切换到无内容\",\n      \"desc\":\"提示用户列表没有内容\",\n       \"schema\":{\n        \"title\":\"列表数据\",\n        \"type\":\"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onScrollLoad\",\n      \"title\": \"当滚动加载时\"\n    },\n    {\n      \"id\": \"onRefresh\",\n      \"title\": \"当下拉刷新时\"\n    },\n    {\n      \"id\": \"getDataSourceSuccess\",\n      \"title\": \"获取瀑布流数据\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\":\"emptySlot\",\n      \"title\":\"无内容插槽\"\n    },\n    {\n      \"id\": \"item\",\n      \"capacity\": 1,\n      \"title\": \"列表项\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"itemData\",\n          \"title\": \"当前项\",\n          \"desc\": \"当前项展示内容\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        },\n        {\n          \"id\": \"index\",\n          \"title\": \"当前项序号\",\n          \"desc\": \"当前项展示的序号\",\n          \"schema\": {\n            \"type\": \"number\"\n          }\n        }\n      ]\n    }\n  ]\n}"
              },
              {
                "path": "src/components/containerList/constant.ts",
                "content": "export enum Direction {\n  Column = 'column',\n  Row = 'row',\n}"
              },
              {
                "path": "src/components/containerList/data.json",
                "content": "{\n  \"direction\": \"column\",\n  \"spacing\": 0,\n  \"useLoading\": true,\n  \"loadingTip\": \"加载中...\",\n  \"errorTip\": \"加载失败，请重试\",\n  \"emptyTip\": \"没有更多了\",\n  \"initialEmptyTip\":\"暂无内容\",\n  \"defaultActive\":\"none\",\n  \"scrollRefresh\": false,\n  \"pullRefresh\": false,\n  \"grid\": {\n    \"column\": 0,\n    \"gutter\": [8, 8]\n  },\n  \"rowKey\": \"id\"\n}\n"
              },
              {
                "path": "src/components/containerList/editors.tsx",
                "content": "import { Direction } from \"./constant\";\n\nexport default {\n  \"@init\": ({ style, data }) => {\n    style.width = 375;\n    style.height = \"auto\";\n  },\n  \":slot\": {},\n  \"@resize\": {\n    options: [\"width\", \"height\"],\n  },\n  \"@inputConnected\"({ data, input, output, slots }, fromPin, toPin) {\n    if (toPin.id === \"dataSource\") {\n      let itemSchema = {};\n      if (fromPin.schema.type === \"array\") {\n        itemSchema = fromPin.schema.items;\n        input.get(\"dataSource\").setSchema(fromPin.schema);\n        slots.get(\"item\").inputs.get(\"itemData\").setSchema(itemSchema);\n      }\n    }\n  },\n  \":root\"({ data, output, style }, cate0, cate1, cate2) {\n    cate0.title = \"循环列表\";\n    cate0.items = [\n      {\n        title: \"基础属性\",\n        items: [\n          {\n            title: \"排列方向\",\n            description:\n              \"列表项的排列方向，竖向排列时，列表项垂直排列；横向排列时，列表项水平排列\",\n            type: \"select\",\n            options: [\n              { label: \"竖向排列\", value: Direction.Column },\n              { label: \"横向排列\", value: Direction.Row },\n            ],\n            value: {\n              get({ data }) {\n                return data.direction ?? Direction.Column;\n              },\n              set({ data }, value) {\n                data.direction = value;\n              },\n            },\n          },\n          {\n            title: \"间距\",\n            description: \"当竖向排列时，为垂直间距；当横向排列时，为水平间距\",\n            type: \"text\",\n            options: {\n              type: \"number\",\n            },\n            value: {\n              get({ data }) {\n                return data.spacing;\n              },\n              set({ data }, value) {\n                data.spacing = value;\n              },\n            },\n          },\n          {\n            title: \"开启换行\",\n            description:\n              \"当横向排列时，开启换行功能，列表项会在到达容器边界时换行\",\n            type: \"switch\",\n            ifVisible({ data }) {\n              return data.direction === Direction.Row;\n            },\n            value: {\n              get({ data }) {\n                return data.wrap;\n              },\n              set({ data }, value) {\n                data.wrap = value;\n              },\n            },\n          },\n          {\n            title: \"默认展示\",\n            description:\n              \"列表初始化时，默认展示的状态，无表示不展示任何内容，加载中表示展示加载中的状态\",\n            type: \"select\",\n            options: [\n              {\n                label: \"无\",\n                value: \"none\",\n              },\n              {\n                label: \"加载中\",\n                value: \"loading\",\n              },\n            ],\n            value: {\n              get({ data }) {\n                return data.defaultActive ?? \"none\";\n              },\n              set({ data, slot }, value) {\n                data.defaultActive = value;\n              },\n            },\n          },\n          {\n            title: \"自动展示无内容状态\",\n            description: \"当传入的数据源为一个空数组[]时，自动切换列表到空状态\",\n            type: \"switch\",\n            value: {\n              get({ data }) {\n                return data.autoEmptyCondition;\n              },\n              set({ data, slot }, value) {\n                data.autoEmptyCondition = value;\n              },\n            },\n          },\n        ],\n      },\n      {\n        catelogChange: {\n          value: {\n            get({ data }) {\n              return data._edit_status_;\n            },\n            set({ data, catelog }) {\n              data._edit_status_ = catelog;\n            },\n          },\n        },\n        items: [\n          {\n            title: \"\",\n            catelog: \"默认\",\n            type: \"editorRender\",\n            options: {\n              render: () => \"暂无\",\n            },\n          },\n          {\n            title: \"提示文案\",\n            description: \"列表加载中时，展示的加载中的文案\",\n            type: \"text\",\n            catelog: \"加载中\",\n            value: {\n              get({ data }) {\n                return data.loadingTip;\n              },\n              set({ data }, value) {\n                data.loadingTip = value;\n              },\n            },\n          },\n          {\n            title: \"提示文案\",\n            description: \"列表加载失败时，展示的加载失败文案\",\n            type: \"text\",\n            catelog: \"加载失败\",\n            value: {\n              get({ data }) {\n                return data.errorTip;\n              },\n              set({ data }, value) {\n                data.errorTip = value;\n              },\n            },\n          },\n          {\n            title: \"提示文案\",\n            description: \"列表没有更多数据时，展示的没有更多文案\",\n            type: \"text\",\n            catelog: \"没有更多\",\n            value: {\n              get({ data }) {\n                return data.emptyTip;\n              },\n              set({ data }, value) {\n                data.emptyTip = value;\n              },\n            },\n          },\n          {\n            title: \"提示文案\",\n            description: \"列表初始化时，展示的空状态文案\",\n            type: \"text\",\n            catelog: \"无内容\",\n            value: {\n              get({ data }) {\n                return data.initialEmptyTip;\n              },\n              set({ data }, value) {\n                data.initialEmptyTip = value;\n              },\n            },\n          },\n          {\n            title: \"无内容插槽\",\n            description: \"是否展示无内容插槽，用于自定义空状态的展示\",\n            type: \"switch\",\n            catelog: \"无内容\",\n            value: {\n              get({ data }) {\n                return data.showEmptySlot;\n              },\n              set({ data }, value) {\n                data.showEmptySlot = value;\n              },\n            },\n          },\n        ],\n      },\n      {\n        title: \"事件\",\n        items: [\n          {\n            title: \"开启滚动加载\",\n            description:\n              \"开启后，支持通过滚动加载更多数据，逻辑编排时注意使用「添加数据」\",\n            type: \"switch\",\n            ifVisible({ data }) {\n              return data.direction !== Direction.Row;\n            },\n            value: {\n              get({ data }) {\n                return data.scrollRefresh;\n              },\n              set({ data }, value) {\n                data.scrollRefresh = value;\n              },\n            },\n          },\n          {\n            title: \"当滚动加载时\",\n            type: \"_event\",\n            ifVisible({ data }: EditorResult<any>) {\n              return !!data.scrollRefresh;\n            },\n            options: {\n              outputId: \"onScrollLoad\",\n            },\n          },\n        ],\n      },\n    ];\n    cate1.title = \"样式\";\n    cate1.items = [];\n    cate2.title = \"高级\";\n    cate2.items = [\n      // {\n      //   title: \"\",\n      //   items: [\n      //     {\n      //       title: \"支持下拉刷新\",\n      //       type: \"switch\",\n      //       value: {\n      //         get({ data }) {\n      //           return data.pullRefresh;\n      //         },\n      //         set({ data }, value) {\n      //           data.pullRefresh = value;\n      //         },\n      //       },\n      //     },\n      //     {\n      //       title: \"当下拉刷新时\",\n      //       type: \"_event\",\n      //       ifVisible({ data }: EditorResult<any>) {\n      //         return !!data.pullRefresh;\n      //       },\n      //       options: {\n      //         outputId: \"onRefresh\",\n      //       },\n      //     },\n      //   ],\n      // },\n      {\n        title: \"唯一主键\",\n        type: \"text\",\n        value: {\n          get({ data }) {\n            return data.rowKey;\n          },\n          set({ data }, value) {\n            data.rowKey = value;\n          },\n        },\n      },\n    ];\n  },\n};\n"
