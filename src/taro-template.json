              {
                "path": "src/components/icon/runtime.tsx",
                "content": "import React, { useCallback, useEffect, useMemo, useState } from \"react\";\nimport css from \"./style.less\";\nimport cx from \"classnames\";\nimport { View } from \"@tarojs/components\";\nimport DynamicIcon from \"../components/dynamic-icon\";\n\nexport default function ({ env, data, logger, slots, inputs, outputs, title }) {\n  const onClick = useCallback((e) => {\n    if (env.runtime) {\n      if (outputs[\"onClick\"].getConnections().length) {\n        e.stopPropagation();\n      }\n      outputs[\"onClick\"](true);\n    }\n  }, []);\n\n  return (\n    <View className={cx(css.icon, \"mybricks-icon\")} onClick={onClick}>\n      <DynamicIcon\n        name={data.icon}\n        size={data.fontSize}\n        color={data.fontColor}\n      />\n    </View>\n  );\n}\n"
              },
