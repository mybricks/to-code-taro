              {
                "path": "src/components/formPhoneNumber/com.json",
                "content": "{\n  \"title\": \"手机输入框\",\n  \"description\": \"通过授权获取手机号。【适用平台：微信小程序】\",\n  \"namespace\": \"mybricks.taro.formPhoneNumber\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/fMG3gMXTltMrqCcL9QsNQLBXMUGKouqB-1743579525212.png\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置表单项值\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取表单项值并输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空表单项值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setPlaceholder\",\n      \"title\": \"设置提示内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      },\n      \"rels\": [\"setDisabledComplete\"]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"getCodeSuccess\",\n      \"title\": \"获取动态令牌成功（仅支持真机）\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"code\": {\n            \"type\": \"string\"\n          },\n          \"errMsg\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"getCodeFail\",\n      \"title\": \"获取动态令牌失败（仅支持真机）\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"errno\": {\n            \"type\": \"number\"\n          },\n          \"errMsg\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
              {
                "path": "src/components/formPhoneNumber/data.json",
                "content": "{\n  \"hideLabel\": false,\n  \"label\": \"手机号码\",\n  \"name\": \"手机号码\",\n  \"value\": \"\",\n  \"placeholder\": \"请授权手机号码\",\n  \"disabled\": false,\n  \"required\": false,\n  \"hidden\": false,\n  \"getPhoneNumberMethods\":\"getRealtimePhoneNumber\",\n  \"buttonText\": \"点击授权\",\n  \"buttonAvailable\": true,\n  \"smsCountdown\":30\n}\n"
              },
              {
                "path": "src/components/formPhoneNumber/editors.tsx",
                "content": "export default {\n  \"@init\": ({ style, data }) => {\n    style.width = \"100%\";\n    style.height = \"auto\";\n  },\n  \"@resize\": {\n    options: [\"width\"],\n  },\n  \":root\": {\n    style: [\n      {\n        title: \"输入框\",\n        options: [\"border\", \"size\", \"padding\", \"background\"],\n        target({ id }) {\n          return [\".mybricks-phoneNumber\", \".mybricks-h5PhoneNumber\"];\n        },\n      },\n      {\n        title: \"内容文本\",\n        options: [\"font\"],\n        target({ id }) {\n          return [\n            `.mybricks-phoneNumber .taroify-input`,\n            `.mybricks-h5PhoneNumber .taroify-input .taroify-native-input`,\n          ];\n        },\n      },\n      {\n        title: \"提示内容文本\",\n        options: [\"font\"],\n        target({ id }) {\n          return [\n            `.mybricks-phoneNumber .taroify-input__placeholder`,\n            `.mybricks-phoneNumber .taroify-input__placeholder--readonly`,\n            `.mybricks-h5PhoneNumber .taroify-native-input::placeholder`,\n          ];\n        },\n      },\n    ],\n    items: ({ data, output, style }, cate0, cate1, cate2) => {\n      cate0.title = \"手机输入框\";\n      cate0.items = [\n        {\n          title: \"基础属性\",\n          items: [\n            {\n              title: \"手机号获取方式\",\n              type: \"radio\",\n              description: \"实时验证仅微信小程序端支持\",\n              options: [\n                { label: \"实时验证\", value: \"getRealtimePhoneNumber\" },\n                { label: \"快速验证\", value: \"getPhoneNumber\" },\n              ],\n              value: {\n                get({ data }) {\n                  return data.getPhoneNumberMethods;\n                },\n                set({ data, output }, value) {\n                  data.getPhoneNumberMethods = value;\n                },\n              },\n            },\n            {\n              title: \"提示内容\",\n              description: \"该提示内容会在值为空时显示\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.placeholder;\n                },\n                set({ data }, value) {\n                  data.placeholder = value;\n                },\n              },\n            },\n            {\n              title: \"按钮文案\",\n              description: \"按钮上显示的文案\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.buttonText;\n                },\n                set({ data }, value) {\n                  data.buttonText = value;\n                },\n              },\n            },\n          ],\n        },\n\n        {\n          title: \"事件\",\n          items: [\n            {\n              title: \"获取动态令牌成功（仅支持真机）\",\n              type: \"_event\",\n              options: {\n                outputId: \"getCodeSuccess\",\n              },\n            },\n            {\n              title: \"获取动态令牌失败（仅支持真机）\",\n              type: \"_event\",\n              options: {\n                outputId: \"getCodeFail\",\n              },\n            },\n            {\n              title: \"当值变化\",\n              type: \"_event\",\n              options: {\n                outputId: \"onChange\",\n              },\n            },\n          ],\n        },\n      ];\n    },\n  },\n\n  \".mybricks-button\": {\n    title: \"授权按钮\",\n    style: [\n      {\n        title: \"授权按钮\",\n        options: [\"size\", \"padding\", \"margin\", \"boxshadow\"],\n        target({ id }) {\n          return [\".mybricks-button\", \".mybricks-button-disabled\"];\n        },\n      },\n      {\n        title: \"按钮启用时\",\n        options: [\"font\", \"border\", \"background\"],\n        target: \".mybricks-button\",\n      },\n      {\n        title: \"按钮禁用时\",\n        options: [\"font\", \"border\", \"background\"],\n        target: \".mybricks-button-disabled\",\n      },\n    ],\n    items: [\n      {\n        title: \"按钮文案\",\n        description: \"按钮上显示的文案\",\n        type: \"text\",\n        value: {\n          get({ data }) {\n            return data.buttonText;\n          },\n          set({ data }, value) {\n            data.buttonText = value;\n          },\n        },\n      },\n    ],\n    \"@dblclick\": {\n      type: \"text\",\n      value: {\n        get({ data }) {\n          return data.buttonText;\n        },\n        set({ data, focusArea }, value) {\n          data.buttonText = value;\n        },\n      },\n    },\n  },\n};\n"
              },
