              {
                "path": "src/components/timeLine/runtime.less",
                "content": ".warrper {\n  width: 100%;\n  height: inherit;\n  overflow-y: scroll;\n\n  .emptyView{\n    min-height: 60px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n  .item {\n    min-height: 30px;\n    width: 100%;\n    display: flex;\n\n    .left_line {\n      width: 25px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: flex-start;\n\n\n      .dot {\n        width: 9px;\n        height: 9px;\n        background-color: rgb(186, 186, 186);\n        border-radius: 50%;\n      }\n\n      .line {\n        width: 1px;\n        flex-grow: 1;\n        background-color: rgb(186, 186, 186);\n      }\n\n      .line_top {\n        width: 1px;\n        height: 10px;\n        background-color: rgb(186, 186, 186);\n      }\n\n      .line_top_first {\n        width: 1px;\n        height: 8px;\n        background-color: none;\n        opacity: 0;\n      }\n    }\n\n    .right_contant {\n      width: calc(100% - 25px);\n      display: flex;\n      flex-direction: column;\n\n      .title {\n        color: rgb(61, 61, 61);\n        font-size: 14px;\n      }\n\n      .contant {\n        width: 100%;\n        height: 100%;\n      }\n    }\n\n  }\n\n  .disabled_area {\n    opacity: 0.4;\n    filter: blur(0.8px);\n    pointer-events: none !important;\n  }\n}"
