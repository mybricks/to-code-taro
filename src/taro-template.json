                      {
                        "path": "src/components/components/taroify/styles/_prefix.scss",
                        "content": "$taroify-prefix: \"t\" + \"a\" + \"r\" + \"o\" + \"i\" + \"f\" + \"y\" + \"-\";\n$component-prefix: $taroify-prefix;\n"
                      },
                      {
                        "path": "src/components/components/taroify/styles/_variables.scss",
                        "content": "// Color Palette\n$black: #000;\n$black-rgb: 0, 0, 0;\n$white: #fff;\n\n$gray-1: #f7f8fa;\n$gray-2: #f2f3f5;\n$gray-3: #ebedf0;\n$gray-4: #dcdee0;\n$gray-5: #c8c9cc;\n$gray-6: #969799;\n$gray-7: #646566;\n$gray-8: #323233;\n\n$red: #ee0a24;\n$blue: #1989fa;\n$cyan: #2db7f5;\n$green: #07c160;\n$orange: #ff976a;\n\n$orange-dark: #ed6a0c;\n$orange-light: #fffbe8;\n\n// Base Unit\n$hd: 2 !default;\n\n// Gradient Colors\n$gradient-red: linear-gradient(to right, #ff6034, #ee0a24);\n$gradient-orange: linear-gradient(to right, #ffd01e, #ff8917);\n\n// Component Colors\n$primary-color: var(--primary-color, $blue);\n$info-color: var(--cyan, $cyan);\n$success-color: var(--green, $green);\n$warning-color: var(--orange, $orange);\n$danger-color: var(--red, $red);\n$text-color: var(--gray-8, $gray-8);\n$text-color-2: var(--gray-6, $gray-6);\n$text-color-3: var(--gray-5, $gray-5);\n$active-color: var(--gray-2, $gray-2);\n$active-opacity: var(--active-opacity, 0.6);\n$disabled-opacity: var(--disabled-opacity, 0.5);\n$background-color: var(--gray-1, $gray-1);\n$background-color-2: var(--white, $white);\n$background-color-light: var(--white, $white);\n$text-link-color: var(--text-link-color, #576b95);\n\n// Padding\n$padding-base: 4px * $hd;\n$padding-xs: $padding-base * 2;\n$padding-sm: $padding-base * 3;\n$padding-md: $padding-base * 4;\n$padding-lg: $padding-base * 6;\n$padding-xl: $padding-base * 8;\n\n// Height\n$height-xs: 16px * $hd;\n$height-sm: 18px * $hd;\n$height-md: 20px * $hd;\n$height-lg: 22px * $hd;\n\n$font-weight-bold: 500;\n\n// Font\n$font-size-xs: 10px * $hd;\n$font-size-sm: 12px * $hd;\n$font-size-md: 14px * $hd;\n$font-size-lg: 16px * $hd;\n// Line Height\n$line-height-xs: 14px * $hd;\n$line-height-sm: 18px * $hd;\n$line-height-md: 20px * $hd;\n$line-height-lg: 22px * $hd;\n\n$base-font-family: -apple-system, blinkmacsystemfont, 'Helvetica Neue',\nhelvetica, segoe ui, arial, roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB',\n'Microsoft Yahei', sans-serif;\n\n$price-integer-font-family: avenir-heavy, pingfang sc, helvetica neue, arial, sans-serif;\n\n// Animation\n$animation-duration-base: 0.3s;\n$animation-duration-fast: 0.2s;\n$animation-timing-function-enter: ease-out;\n$animation-timing-function-exit: ease-in;\n\n// Border\n$border-color: var(--gray-3, $gray-3);\n$border-width-base: 1px * $hd;\n$border-radius-sm: 2px * $hd;\n$border-radius-md: 4px * $hd;\n$border-radius-lg: 8px * $hd;\n$border-radius-max: 999px;\n"
