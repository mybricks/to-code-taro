                  {
                    "path": "src/components/filter-coms/select/com.json",
                    "content": "{\n  \"title\": \"下拉选择\",\n  \"namespace\": \"mybricks.taro.filterSelect\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"./preview.png\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置下拉选择的值，并触发值变化事件输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setInitialValue\",\n      \"title\": \"设置初始值\",\n      \"desc\": \"设置下拉选择的初始值，并触发初始化事件输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取下拉选择的值并输出\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空下拉选择的值\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"值更新\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    }\n  ],\n  \"schema\": [\"mybricks.taro.filters/item\", \"*\"]\n}\n"
