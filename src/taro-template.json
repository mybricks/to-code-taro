              {
                "path": "src/components/map/com.json",
                "content": "{\n  \"title\": \"地图\",\n  \"namespace\": \"mybricks.taro.map\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime.edit\": \"./edit/runtime.tsx\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"ai\": \"./ai.ts\",\n  \"icon\": \"./icon.svg\",\n  \"inputs\": [\n    {\n      \"id\": \"setPos\",\n      \"title\": \"设置地图中心点\",\n      \"description\": \"通过经纬度设置地图中心点\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"longitude\": {\n            \"title\": \"经度\",\n            \"description\": \"经度\",\n            \"type\": \"string\"\n          },\n          \"latitude\": {\n            \"title\": \"纬度\",\n            \"description\": \"纬度\",\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"rels\": [\n        \"onSetPosOk\"\n      ]\n    },\n    {\n      \"id\": \"draw\",\n      \"title\": \"绘制图形\",\n      \"description\": \"清空已有的图形，绘制新的图形\",\n      \"schema\": {\n        \"type\": \"object\"\n      }\n    },\n    {\n      \"id\": \"addDraw\",\n      \"title\": \"添加图形\",\n      \"description\": \"保留已有的图形，添加新的图形\",\n      \"schema\": {\n        \"type\": \"object\"\n      }\n    },\n    {\n      \"id\": \"setScale\",\n      \"title\": \"缩放地图\",\n      \"description\": \"缩放级别，取值范围为 3-20（默认值16）\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    },\n    {\n      \"id\": \"includePoints\",\n      \"title\": \"根据点位缩放视野\",\n      \"description\": \"根据所有点位坐标缩放视野\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"points\": {\n            \"title\": \"坐标点列表\",\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"longitude\": {\n                  \"title\": \"经度\",\n                  \"description\": \"经度\",\n                  \"type\": \"string\"\n                },\n                \"latitude\": {\n                  \"title\": \"纬度\",\n                  \"description\": \"纬度\",\n                  \"type\": \"string\"\n                }\n              }\n            }\n          },\n          \"padding\": {\n            \"title\": \"四周间距\",\n            \"description\": \"四周间距\",\n            \"type\": \"array\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"setMarkers\",\n      \"title\": \"设置标记点\",\n      \"description\": \"设置地图上的标记点\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"longitude\": {\n            \"title\": \"经度\",\n            \"description\": \"经度\",\n            \"type\": \"string\"\n          },\n          \"latitude\": {\n            \"title\": \"纬度\",\n            \"description\": \"纬度\",\n            \"type\": \"string\"\n          },\n          \"iconPath\": {\n            \"title\": \"图标地址\",\n            \"description\": \"图标的url地址\",\n            \"type\": \"string\"\n          },\n          \"width\": {\n            \"title\": \"图标宽度\",\n            \"description\": \"图标宽度\",\n            \"type\": \"string\"\n          },\n          \"height\": {\n            \"title\": \"图标高度\",\n            \"description\": \"图标高度\",\n            \"type\": \"string\"\n          },\n          \"callout\": {\n            \"title\": \"气泡\",\n            \"type\": \"object\",\n            \"properties\": {\n              \"content\": {\n                \"title\": \"气泡提示文本内容\",\n                \"description\": \"气泡提示文本内容\",\n                \"type\": \"string\"\n              },\n              \"color\": {\n                \"title\": \"颜色\",\n                \"description\": \"字体颜色\",\n                \"type\": \"string\"\n              },\n              \"fontSize\": {\n                \"title\": \"字体大小\",\n                \"description\": \"字体大小\",\n                \"type\": \"string\"\n              },\n              \"borderRadius\": {\n                \"title\": \"边框圆角\",\n                \"description\": \"边框圆角\",\n                \"type\": \"string\"\n              },\n              \"borderWidth\": {\n                \"title\": \"边框宽度\",\n                \"description\": \"边框宽度\",\n                \"type\": \"string\"\n              },\n              \"borderColor\": {\n                \"title\": \"边框颜色\",\n                \"description\": \"边框颜色\",\n                \"type\": \"string\"\n              },\n              \"bgColor\": {\n                \"title\": \"背景颜色\",\n                \"description\": \"背景颜色\",\n                \"type\": \"string\"\n              },\n              \"padding\": {\n                \"title\": \"文本边缘留白\",\n                \"description\": \"文本边缘留白\",\n                \"type\": \"string\"\n              },\n              \"display\": {\n                \"title\": \"显示方式\",\n                \"description\": \"'BYCLICK':点击显示; 'ALWAYS':常显\",\n                \"type\": \"string\"\n              },\n              \"textAlign\": {\n                \"title\": \"对齐方式\",\n                \"description\": \"文本对齐方式。有效值: left, right, center\",\n                \"type\": \"string\"\n              }\n            }\n          }\n        }\n      },\n      \"rels\": [\n        \"setMarkersOk\"\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onSetPosOk\",\n      \"title\": \"设置中心点成功\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"id\": \"setMarkersOk\",\n      \"title\": \"设置标记点成功\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"content\",\n      \"title\": \"内容\"\n    }\n  ]\n}"
              },
