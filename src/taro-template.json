                    "path": "src/components/components-h5/tabs/index.tsx",
                    "content": "import React, { CSSProperties, useEffect, useState } from \"react\";\nimport styles from \"./index.less\";\nimport cls from \"classnames\";\n\ninterface TabProps {\n  value: string;\n  items: [\n    {\n      _id: string;\n      tabName: string;\n    }\n  ];\n  swipeable?: boolean;\n  onChange: (id: string) => void;\n  children: React.ReactNode;\n}\n\nconst Tab = (props: TabProps) => {\n  const { value, items, swipeable, onChange, children } = props;\n\n  const tabClick = (id) => {\n    onChange(id);\n  };\n\n  return (\n    <div>\n      <div className={styles.tabs}>\n        {/* 底部有线的tab样式 */}\n        <div className={styles.tab_line}>\n          {items.map((items) => (\n            <div\n              key={items._id}\n              onClick={() => tabClick(items._id)}\n              className={cls(\n                styles.tabItem_line,\n                items._id == value ? styles.active : \"\"\n              )}\n              style={{ flexGrow: 0 }}\n            >\n              {items.tabName}\n              {items._id == value ? (\n                <div\n                  className={styles.line}\n                  style={{ backgroundColor: \"#FA6400\" }}\n                ></div>\n              ) : null}\n            </div>\n          ))}\n        </div>\n      </div>\n      <div>{children}</div>\n    </div>\n  );\n};\n\nexport default Tab;\n"
