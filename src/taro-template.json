              {
                "path": "src/components/cell/com.json",
                "content": "{\n  \"title\": \"单元格\",\n  \"namespace\": \"mybricks.taro.cell\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.1\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"value\",\n      \"title\": \"修改内容\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\",\n            \"title\": \"单元格标题\",\n            \"description\": \"单元格标题\"\n          },\n          \"thumb\": {\n            \"type\": \"string\",\n            \"title\": \"单元格icon\",\n            \"description\": \"单元格icon\"\n          },\n          \"brief\": {\n            \"type\": \"string\",\n            \"title\": \"单元格描述\",\n            \"description\": \"单元格描述\"\n          },\n          \"content\": {\n            \"type\": \"string\",\n            \"title\": \"单元格内容\",\n            \"description\": \"单元格内容\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"swipe\",\n      \"title\": \"开启左滑\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onClick\",\n      \"title\": \"单击\"\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"children\",\n      \"title\": \"内容\"\n    }\n  ]\n}"
              },
              {
                "path": "src/components/cell/data.json",
                "content": "{\n  \"size\": \"large\",\n  \"align\": \"center\",\n  \"useThumb\": false,\n  \"thumb\": \"\",\n  \"title\": \"单元格\",\n  \"brief\": \"描述信息\",\n  \"useChildren\": false,\n  \"slotStyle\": {},\n  \"content\": \"内容\",\n  \"useArrowIcon\": true,\n  \"arrowIconColor\": \"#969799\",\n\n  \"useSwipeLeft\": false,\n  \"leftSwipeText\": \"删除\",\n  \"leftSwipeWidth\": 80,\n  \"leftSwipeBgColor\": \"#df505c\",\n\n  \"leftSwipeStyle\":{\n    \"width\": 50\n  },\n  \"leftSwipeStyleSecondary\":{\n    \"width\": 50\n  }\n}\n"
