                "path": "src/components/activityCard/icon.svg",
                "content": "<?xml version=\"1.0\" standalone=\"no\"?><!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\"><svg t=\"1677121260552\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"6843\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"128\" height=\"128\"><path d=\"M848.704 985.088a32.32 32.32 0 0 1-22.656-9.344l-91.84-91.84-88.512 88.512a32 32 0 0 1-45.248 0L512 883.904l-90.24 90.24a32 32 0 0 1-45.248 0l-90.304-90.24-91.008 90.944a31.488 31.488 0 0 1-32.448 7.808 96.128 96.128 0 0 1-67.072-91.712V135.488A96.64 96.64 0 0 1 192.256 38.912h639.552c53.248 0 96.64 43.328 96.64 96.576v755.52c0 43.264-29.312 81.408-71.232 92.928a32.448 32.448 0 0 1-8.512 1.152z m-114.432-178.432c8.192 0 16.384 3.136 22.656 9.344l97.856 97.856a32.192 32.192 0 0 0 9.6-22.848V135.488a32.64 32.64 0 0 0-32.64-32.576H192.192a32.64 32.64 0 0 0-32.576 32.576v755.52c0 7.936 2.88 15.296 7.872 20.992l96-96a32 32 0 0 1 45.248 0l90.304 90.24 90.24-90.24a32 32 0 0 1 45.248 0l88.512 88.512 88.512-88.512a32.128 32.128 0 0 1 22.72-9.344z\" fill=\"#333333\" p-id=\"6844\"></path><path d=\"M707.52 330.944H310.912a32 32 0 0 1 0-64h396.544a32 32 0 0 1 0.064 64zM707.52 484.032H310.912a32 32 0 0 1 0-64h396.544a32 32 0 0 1 0.064 64zM707.52 637.056H310.912a32 32 0 0 1 0-64h396.544a32 32 0 0 1 0.064 64z\" fill=\"#333333\" p-id=\"6845\"></path></svg>"
