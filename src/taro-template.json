              {
                "path": "src/components/cell/icon.svg",
                "content": "<?xml version=\"1.0\" standalone=\"no\"?><!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\"><svg t=\"1684829656717\" class=\"icon\" viewBox=\"0 0 3840 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"19490\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"480\" height=\"128\"><path d=\"M0 213.376C0 95.616 122.88 0 274.304 0h3291.392C3717.248 0 3840 95.488 3840 213.376v597.248C3840 928.384 3717.12 1024 3565.696 1024H274.304C122.752 1024 0 928.512 0 810.624V213.376z\" fill=\"#333333\" fill-opacity=\".08\" opacity=\".6\" p-id=\"19491\"></path><path d=\"M896 384h2560v256H896V384z\" fill=\"#333333\" p-id=\"19492\"></path><path d=\"M640 512a128 128 0 1 1-256 0 128 128 0 0 1 256 0z\" fill=\"#333333\" p-id=\"19493\"></path><path d=\"M3584 128a128 128 0 0 1 128 128v512a128 128 0 0 1-128 128H256a128 128 0 0 1-128-128V256a128 128 0 0 1 128-128h3328zM256 0a256 256 0 0 0-256 256v512a256 256 0 0 0 256 256h3328a256 256 0 0 0 256-256V256a256 256 0 0 0-256-256H256z\" fill=\"#333333\" p-id=\"19494\"></path></svg>"
