            "children": [
              {
                "path": "src/components/smsInput/ai.ts",
                "content": "export default {\n  ':root' ({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: '验证码宫格，支持输入、获取验证码',\n    usage: `验证码宫格，支持输入、获取验证码\n\nslots插槽\n无\n\n`\n  }\n}"
              },
              {
                "path": "src/components/smsInput/com.json",
                "content": "{\n  \"title\": \"验证码宫格\",\n  \"namespace\": \"mybricks.taro.smsInput\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"./preview.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"startCountdown\",\n      \"title\": \"开始计时\",\n      \"desc\": \"开始倒数计时\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\n        \"startCountdownDone\"\n      ]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取输入的值并输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\n        \"returnValue\"\n      ]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空输入的值\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    },\n    {\n      \"id\":\"setError\",\n      \"title\":\"设置为输入错误\",\n      \"desc\":\"设置输入框为验证码输入错误状态\",\n      \"schema\":{\n        \"type\":\"any\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"值更新\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onComplete\",\n      \"title\": \"填满输入框时\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onSendSMS\",\n      \"title\": \"点击发送验证码\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"startCountdownDone\",\n      \"title\": \"触发开始计时完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    }\n  ]\n}"
              },
              {
                "path": "src/components/smsInput/data.json",
                "content": "{\n  \"value\":\"\",\n  \"length\":6,\n  \"gutter\":10,\n  \"countdown\":60,\n  \"countDownText\":\"秒后重新获取验证码\",\n  \"retryText\":\"重新获取验证码\",\n  \"errorText\":\"验证码错误\",\n  \"buttonAvailable\":true\n}\n"
              },
              {
                "path": "src/components/smsInput/editors.tsx",
                "content": "export default {\n  \"@init\": ({ style, data }) => {\n    style.width = 350;\n    style.height = 85;\n  },\n  \"@resize\": {\n    options: [\"width\", \"height\"],\n  },\n  \":root\": {\n    style: [\n      {\n        title: \"宫格间距\",\n        type: \"InputNumber\",\n        options: [{ min: 0 }],\n        value: {\n          get({ data }) {\n            return [data.gutter];\n          },\n          set({ data }, value) {\n            data.gutter = value[0];\n          },\n        },\n      },\n      {\n        title: \"宫格样式配置\",\n        options: [\"size\", \"font\", \"border\", \"background\", \"margin\"],\n        target: `#mybricks-input-item`,\n      },\n      {\n        title: \"描述文字配置\",\n        options: [\"font\"],\n        target: `#mybricks-input-desc`,\n      },\n    ],\n    items: ({ data, output, style }, cate0, cate1, cate2) => {\n      cate0.title = \"验证码宫格\";\n      cate0.items = [\n        {\n          title: \"基础属性\",\n          items: [\n            {\n              title: \"验证码位数\",\n              type: \"InputNumber\",\n              options: [{ min: 1, max: 8 }],\n              description: \"输入的位数限制 1~8\",\n              value: {\n                get({ data }) {\n                  return [data.length];\n                },\n                set({ data }, value) {\n                  data.length = value[0];\n                },\n              },\n            },\n            {\n              title: \"验证码倒数秒数\",\n              description: \"验证码发送后倒数秒数\",\n              type: \"InputNumber\",\n              options: [{ min: 1 }],\n              value: {\n                get({ data }) {\n                  return [data.countdown];\n                },\n                set({ data }, value) {\n                  data.countdown = value[0];\n                },\n              },\n            },\n            {\n              title: \"倒数文案\",\n              description: \"验证码发送后，倒数秒数后显示的文案\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.countDownText;\n                },\n                set({ data }, value) {\n                  data.countDownText = value;\n                },\n              },\n            },\n            {\n              title: \"重试文案\",\n              description: \"倒计时结束后，重新发送验证码的文案\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.retryText;\n                },\n                set({ data }, value) {\n                  data.retryText = value;\n                },\n              },\n            },\n            {\n              title: \"错误文案\",\n              description: \"验证码输入错误时显示的文案\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.errorText;\n                },\n                set({ data }, value) {\n                  data.errorText = value;\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"高级属性\",\n          items: [\n            {\n              title: \"显示中间分割线\",\n              description: \"验证码输入框中间显示分割符，只支持偶数的验证码位数\",\n              type: \"switch\",\n              value: {\n                get({ data }) {\n                  return data.showLine;\n                },\n                set({ data }, value) {\n                  data.showLine = value;\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"事件\",\n          items: [\n            {\n              title: \"当值变化\",\n              type: \"_event\",\n              options: {\n                outputId: \"onChange\",\n              },\n            },\n            {\n              title: \"填满输入框时\",\n              type: \"_event\",\n              options: {\n                outputId: \"onComplete\",\n              },\n            },\n            {\n              title: \"发送验证码\",\n              type: \"_event\",\n              options: {\n                outputId: \"onSendSMS\",\n              },\n            },\n          ],\n        },\n      ];\n    },\n  },\n  \".mybricks-desc\": {\n    \"@dblclick\": {\n      type: \"text\",\n      value: {\n        get({ data }) {\n          return data.retryText;\n        },\n        set({ data, focusArea }, value) {\n          data.retryText = value;\n        },\n      },\n    },\n  },\n};\n"
              },
