              {
                "path": "src/components/formLocation/com.json",
                "content": "{\n  \"title\": \"省市区选择\",\n  \"namespace\": \"mybricks.taro.formLocation\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/ETrg6eSG1FEPdvvBLkTz7bk4HMWx5BTq-1743579393544.png\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置值，并触发值变化事件输出 示例:[\\\"北京\\\",\\\"杭州\\\"]\",\n      \"schema\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取值并输出 示例:[\\\"北京\\\",\\\"杭州\\\"]\",\n      \"schema\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setPlaceholder\",\n      \"title\": \"设置提示内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"content\",\n      \"title\": \"可点击插槽\"\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
              {
                "path": "src/components/formLocation/data.json",
                "content": "{\n  \"label\": \"省市区选择\",\n  \"name\": \"省市区选择\",\n  \"value\": [],\n  \"placeholder\": \"点击选择地址\",\n  \"level\": \"city\"\n}\n"
              },
              {
                "path": "src/components/formLocation/editors.tsx",
                "content": "export default {\n  \"@init\": ({ style, data }) => {\n    style.width = \"100%\";\n    style.height = \"auto\";\n  },\n  \"@resize\": {\n    options: [\"width\", \"height\"],\n  },\n  \":slot\": {},\n  \":root\": {\n    style: [\n      {\n        title: \"样式\",\n        options: [\"border\", \"background\"],\n        target: `.mybricks-formLocation`,\n      },\n      {\n        title: \"字体样式\",\n        options: [\"font\"],\n        target: `.mybricks-input`,\n      },\n    ],\n    items: ({ data, output, style }, cate0, cate1, cate2) => {\n      cate0.title = \"省市区选择\";\n      cate0.items = [\n        {\n          title: \"基础属性\",\n          items: [\n            {\n              title: \"提示内容\",\n              description: \"该提示内容会在值为空时显示\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.placeholder;\n                },\n                set({ data }, value) {\n                  data.placeholder = value;\n                },\n              },\n            },\n            {\n              title: \"选择器层级\",\n              description: \"用于设置选择器的层级\",\n              type: \"select\",\n              options: [\n                { label: \"省级选择器\", value: \"province\" },\n                { label: \"市级选择器\", value: \"city\" },\n                { label: \"区级选择器\", value: \"region\" },\n                { label: \"街道选择器\", value: \"sub-district\" },\n              ],\n              value: {\n                get({ data }) {\n                  return data.level;\n                },\n                set({ data }, value) {\n                  data.level = value;\n                },\n              },\n            },\n            {\n              title: \"禁用编辑\",\n              description: \"是否禁用编辑\",\n              type: \"Switch\",\n              value: {\n                get({ data }) {\n                  return data.disabled;\n                },\n                set({ data }, value) {\n                  data.disabled = value;\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"高级属性\",\n          items: [\n            {\n              title: \"配置为插槽\",\n              description: \"开启后可自定义省市区选择的触发区域\",\n              type: \"switch\",\n              value: {\n                get({ data }) {\n                  return data.isSlot;\n                },\n                set({ data, slot, style }, value) {\n                  data.isSlot = value;\n                  if (value) {\n                    // const slotInstance = slot.get(\"content\");\n                    // setSlotLayout(slotInstance, data.slotStyle);\n                    style.height = 50;\n                    style.width = 50;\n                  } else {\n                    style.height = 24;\n                    style.width = 375;\n                  }\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"事件\",\n          items: [\n            {\n              title: \"当值变化\",\n              type: \"_event\",\n              options: {\n                outputId: \"onChange\",\n              },\n            },\n          ],\n        },\n      ];\n    },\n  },\n};\n"
              },
