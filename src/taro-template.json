H109.957852c-21.939571 0-36.569286-14.629714-36.569285-36.569286V109.717857c0-21.939571 14.629714-36.569286 36.569285-36.569286h804.554286c21.939571 0 36.569286 14.629714 36.569286 36.569286v804.554286z m0 0\" fill=\"#555555\" p-id=\"2299\"></path></svg>"
              },
              {
                "path": "src/components/containerBasic/runtime.tsx",
                "content": "import React, { useCallback } from \"react\";\nimport { View } from \"@tarojs/components\";\nimport css from \"./style.less\";\nimport cx from \"classnames\";\nimport Taro from \"@tarojs/taro\";\n\nexport default function ({ env, data, slots, inputs, outputs }) {\n  const onClick = useCallback((e) => {\n    if (!env.runtime) {\n      return;\n    }\n\n    // 当配置了单击事件，阻止事件冒泡\n    if (outputs[\"onClick\"].getConnections().length) {\n      e.stopPropagation();\n    }\n\n    outputs[\"onClick\"]?.();\n  }, []);\n\n  return (\n    <View className={cx(css.container, \"mybricks-container\")} onClick={onClick}>\n      {slots[\"content\"].render({\n        style: {\n          ...data.layout || { position: \"smart\"},\n        },\n      })}\n    </View>\n  );\n}\n"
              },
              {
                "path": "src/components/containerBasic/style.less",
                "content": ".container {\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  pointer-events: auto;\n}\n\n:global(.mybricks_slot) {\n  overflow: unset !important;\n}\n"
              }
            ]
          },
          {
            "path": "src/components/containerCondition",
            "content": null,
            "children": [
              {
                "path": "src/components/containerCondition/com.json",
                "content": "{\n  \"title\": \"条件容器\",\n  \"namespace\": \"mybricks.taro.containerCondition\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"切换到 指定条件\",\n      \"rels\": [\n        \"setValueDone\"\n      ],\n      \"desc\": \"根据输入的条件名来切换\"\n    },\n    {\n      \"id\": \"condition_1\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"title\": \"切换到 条件1\",\n      \"rels\": [\n        \"changeDone\"\n      ]\n    },\n    {\n      \"id\": \"condition_2\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"title\": \"切换到 条件2\",\n      \"rels\": [\n        \"changeDone\"\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"changeDone\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"title\": \"切换完成\"\n    },\n    {\n      \"id\": \"setValueDone\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"title\": \"切换条件完成\"\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"condition_1\",\n      \"title\": \"条件1\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"itemData\",\n          \"title\": \"传入的数据\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"condition_2\",\n      \"title\": \"条件2\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"itemData\",\n          \"title\": \"传入的数据\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        }\n      ]\n    }\n  ]\n}"
              },
              {
                "path": "src/components/containerCondition/data.json",
