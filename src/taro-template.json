              {
                "path": "src/components/formPhoneNumber/runtime.tsx",
                "content": "import React, { useCallback, useEffect, useMemo, useRef } from \"react\";\nimport { View, Button } from \"@tarojs/components\";\nimport { Input } from \"brickd-mobile\";\nimport css from \"./style.less\";\nimport cx from \"classnames\";\nimport * as Taro from \"@tarojs/taro\";\nimport { isEmpty, isString, isNumber, isObject } from \"./../utils/type\";\nimport useFormItemValue from \"../utils/hooks/useFormItemValue.ts\";\nimport { isH5 } from \"../utils/env\";\n\nexport default function (props) {\n  const { env, data, inputs, outputs, slots, parentSlot } = props;\n\n  const [value, setValue, getValue] = useFormItemValue(data.value, (val) => {\n    //\n    parentSlot?._inputs[\"onChange\"]?.({\n      id: props.id,\n      name: props.name,\n      value: val,\n    });\n\n    //\n    outputs[\"onChange\"](val);\n  });\n\n  useEffect(() => {\n    parentSlot?._inputs[\"setProps\"]?.({\n      id: props.id,\n      name: props.name,\n      value: {\n        visible: props.style.display !== \"none\",\n      },\n    });\n  }, [props.style.display]);\n\n  useEffect(() => {\n    /* 设置值 */\n    inputs?.[\"setValue\"]((val, outputRels) => {\n      let result;\n\n      switch (true) {\n        case isEmpty(val): {\n          result = \"\";\n          break;\n        }\n        case isString(val) || isNumber(val):\n          result = `${val}`;\n          break;\n        default:\n          // 其他类型的值，直接返回\n          return;\n      }\n      setValue(result);\n      outputRels[\"setValueComplete\"]?.(result); // 表单容器调用 setValue 时，没有 outputRels\n    });\n\n    /* 获取值 */\n    inputs?.[\"getValue\"]((val, outputRels) => {\n      outputRels[\"returnValue\"](getValue());\n    });\n\n    /* 重置值 */\n    inputs?.[\"resetValue\"]((val, outputRels) => {\n      setValue(\"\");\n      outputRels[\"resetValueComplete\"]?.(\"\");\n    });\n\n    /* 设置标题 */\n    inputs?.[\"setLabel\"]?.((val) => {\n      if (!isString(val)) {\n        return;\n      }\n\n      parentSlot?._inputs[\"setProps\"]?.({\n        id: props.id,\n        name: props.name,\n        value: {\n          label: val,\n        },\n      });\n    });\n\n    /* 设置提示内容 */\n    inputs?.[\"setPlaceholder\"]((val) => {\n      data.placeholder = val;\n    });\n\n    /* 设置禁用 */\n    inputs?.[\"setDisabled\"]?.((val, outputRels) => {\n      data.disabled = !!val;\n      outputRels[\"setDisabledComplete\"]?.(data.disabled);\n    });\n  }, []);\n\n  const openType = useMemo(() => {\n    switch (true) {\n      case data.getPhoneNumberMethods === \"getPhoneNumber\": {\n        return {\n          openType: \"getPhoneNumber\",\n          onGetPhoneNumber: (e) => {\n            e.stopPropagation();\n\n            if (!!e.detail.errno) {\n              outputs[\"getCodeFail\"]({\n                ...e.detail,\n              });\n            } else {\n              outputs[\"getCodeSuccess\"]({\n                ...e.detail,\n              });\n            }\n          },\n        };\n      }\n\n      case data.getPhoneNumberMethods === \"getRealtimePhoneNumber\": {\n        return {\n          openType: \"getRealtimePhoneNumber\",\n          onGetRealtimePhoneNumber: (e) => {\n            e.stopPropagation();\n\n            if (!!e.detail.errno) {\n              outputs[\"getCodeFail\"]({\n                ...e.detail,\n              });\n            } else {\n              outputs[\"getCodeSuccess\"]({\n                ...e.detail,\n              });\n            }\n          },\n        };\n      }\n    }\n  }, [data.getPhoneNumberMethods]);\n\n  const onChange = useCallback((e) => {\n    let value = e.detail.value;\n    setValue(value);\n  }, []);\n\n  return (\n    <View\n      className={cx({\n        [css.phoneNumber]: true,\n        \"mybricks-phoneNumber\": !isH5(),\n        \"mybricks-h5PhoneNumber\": isH5(),\n      })}\n    >\n      <View className={css.inner}>\n        <Input\n          className={css.input}\n          value={value}\n          placeholder={data.placeholder}\n          onChange={onChange}\n          readonly={true}\n        />\n        <Button\n          className={cx({\n            [css.button]: true,\n            [css.enabled]: !data.disabled,\n            \"mybricks-button\": !data.disabled,\n            [css.disabled]: data.disabled,\n            \"mybricks-button-disabled\": data.disabled,\n          })}\n          {...openType}\n        >\n          {data.buttonText || \"点击授权\"}\n        </Button>\n      </View>\n    </View>\n  );\n}\n"
              },
              {
                "path": "src/components/formPhoneNumber/style.less",
                "content": ".phoneNumber {\n  position: relative;\n  height: 24px;\n  width: 100%;\n  .inner {\n    width: 100%;\n    height: 100%;\n    position: relative;\n  }\n\n  .input {\n    height: 100%;\n  }\n\n  :global {\n    // H5的垫片，不能让他有样式\n    .taroify-native-input {\n      // H5兼容，给input配置字体大小，不然不会编译成vw\n      font-size: 14px;\n      border: none;\n      background: transparent;\n      &::placeholder {\n        font-size: 14px;\n        color: #c8c9cc;\n      }\n    }\n\n    .taroify-input__placeholder,\n    .taroify-input__placeholder--readonly {\n      font-size: 14px;\n      color: #c8c9cc;\n    }\n  }\n\n  .button {\n    position: absolute !important;\n    top: 50%;\n    right: 0;\n    transform: translateY(-50%);\n    width: fit-content;\n    padding: 0;\n    border: none;\n    font-size: 12px;\n    line-height: 24px;\n    font-weight: 500;\n    background: none;\n    border: none;\n    z-index: 99;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    &::after {\n      display: none;\n    }\n\n    &.enabled {\n      color: #ea732e;\n    }\n\n    &.disabled {\n      color: #999999;\n    }\n  }\n}\n"
              }
            ]
          },
          {
            "path": "src/components/formPhoneSMS",
            "content": null,
            "children": [
              {
                "path": "src/components/formPhoneSMS/com.json",
                "content": "{\n  \"title\": \"验证码输入框\",\n  \"namespace\": \"mybricks.taro.formPhoneSMS\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/D2nMy6RuXFLVkETAsdKXH0YlZVffOQt3-1743579644971.png\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置表单项值\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取表单项值并输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空表单项值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"clearCountDown\",\n      \"title\": \"立即清除倒数\",\n      \"desc\": \"触发后停止倒计时\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"clearCountDownComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setPlaceholder\",\n      \"title\": \"设置提示内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onBlur\",\n      \"title\": \"当失去焦点\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"onCodeSend\",\n      \"title\": \"获取验证码\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"clearCountDownComplete\",\n      \"title\": \"清除完成\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
              {
                "path": "src/components/formPhoneSMS/data.json",
