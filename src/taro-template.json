                  {
                    "path": "src/components/components-vue/tabs/index.less",
                    "content": ".tabs {\n    margin-bottom: 5px;\n    width: 100%;\n    margin-left: auto;\n    margin-right: auto;\n    border-radius: 10px;\n    overflow: hidden;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n\n    // LINE\n    .tab_line {\n        height: 44px;\n        line-height: 44px;\n        display: flex;\n        margin-bottom: 0px;\n        overflow-x: auto;\n        overflow-y: hidden;\n        align-items: center;\n\n        &::-webkit-scrollbar {\n            display: none;\n        }\n\n        .tabItem_line {\n            flex-grow: 0;\n            flex-shrink: 0;\n            position: relative;\n            color: #313131;\n            font-size: 16px;\n            font-weight: 500;\n            opacity: 0.7;\n            padding: 0 19px;\n            align-items: center;\n\n\n            .tabItem_pic {\n                width: 100%;\n                height: 40px;\n                margin-top: 15px;\n                object-fit: contain;\n            }\n\n            &:first-of-type {\n                padding-left: 18px;\n            }\n\n            &:last-of-type {\n                padding-right: 18px;\n            }\n\n            &.active {\n                opacity: 1;\n                font-size: 17px;\n                font-weight: 600;\n\n                .line {\n                    position: absolute;\n                    bottom: 5px;\n                    left: 50%;\n                    transform: translateX(-50%);\n                    background-color: #FA6400;\n                    width: 20px;\n                    height: 2px;\n                    border-radius: 1px;\n                }\n            }\n        }\n    }\n}"
                  },
                  {
                    "path": "src/components/components-vue/tabs/index.vue",
                    "content": "<template>\n    <div>\n        <div>\n            <div class=\"tabs\">\n                <div class=\"tab_line\">\n                    <div v-for=\"item in items\" :key=\"item._id\" @click=\"tabClick(item._id)\"\n                        :class=\"['tabItem_line', isActive(item._id) ? 'active taroify-tabs__tab--active' : 'taroify-tabs__tab']\">\n                        <!-- 激活的情况 -->\n                        <div v-show=\"isActive(item._id)\">\n                            <div v-show=\"item.tabPicActive\">\n                                <img :src=\"item.tabPicActive\" class=\"tabItem_pic\" alt=\"\" />\n                            </div>\n                            <div v-show=\"!item.tabPicActive\">{{ item.tabName }}</div>\n                            <div v-show=\"item._id === value\" class=\"line taroify-tabs__line\"></div>\n                        </div>\n                        <!-- 非激活的情况 -->\n                        <div v-show=\"!isActive(item._id)\">\n                            <div v-show=\"item.tabPic\">\n                                <img :src=\"item.tabPic\" class=\"tabItem_pic\" alt=\"\" />\n                            </div>\n                            <div v-show=\"!item.tabPic\">{{ item.tabName }}</div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n        <div>\n            <slot></slot>\n        </div>\n    </div>\n</template>\n<script>\n\nexport default {\n    inheritAttrs: true,\n    props: ['value', 'items'],\n    data() {\n        return {\n\n        }\n    },\n    created() {\n        console.log(\"tabs created\", this)\n    },\n    mounted() {\n        console.log(\"tabs mounted\", this)\n    },\n    methods: {\n\n        tabClick(id) {\n            // emit('change', id)\n            this.$emit('change', id)\n        },\n        isActive(itemId) {\n            return itemId === this.value ? true : false;\n        }\n    }\n}\n\n</script>\n\n<style scoped lang=\"less\">\n@import \"./index.less\";\n</style>\n"
                  }
                ]
              }
            ]
          },
