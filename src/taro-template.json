                "content": "{\n  \"title\": \"标签\",\n  \"namespace\": \"mybricks.taro.tag\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"inputs\": [],\n  \"outputs\": [],\n  \"slots\": []\n}\n"
