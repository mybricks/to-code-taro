                "content": "{\n  \"title\": \"二维码\",\n  \"namespace\": \"mybricks.taro.qrcode\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"icon\": \"./icon.svg\",\n  \"version\": \"1.0.0\",\n  \"description\": \"二维码\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"ai\": \"./ai.ts\",\n  \"editors\": \"./editors.tsx\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"修改二维码内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    }\n  ],\n  \"outputs\": []\n}\n"
