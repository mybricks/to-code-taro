                    "path": "src/components/timeLine/edit/runtime.tsx",
                    "content": "import * as React from 'react';\nimport  Runtime  from './../runtime'\nimport { useDisabledArea } from './../../utils/hooks';\n\nexport default (props) => {\n\n  const DisabledArea = useDisabledArea()\n\n  return (\n    <DisabledArea>\n      <Runtime {...props} />\n    </DisabledArea>\n  )\n  \n}"
                  }
                ]
              },
              {
                "path": "src/components/timeLine/com.json",
                "content": "{\n  \"title\": \"时间轴\",\n  \"namespace\": \"mybricks.taro.timeLine\",\n  \"version\": \"1.0.0\",\n  \"description\": \"时间轴\",\n  \"author\": \"MyBricks\",\n  \"author_name\": \"MyBricks\",\n  \"icon\": \"./icon.svg\",\n  \"data\": \"./data.json\",\n  \"runtime\": \"./runtime.tsx\",\n    \"runtime.edit\": \"./edit/runtime.tsx\",\n  \"editors\": \"./editors.tsx\",\n  \"inputs\": [\n    {\n      \"id\": \"refreshDataSource\",\n      \"title\": \"覆盖数据\",\n      \"desc\": \"时间轴已有的数据会被覆盖\",\n      \"schema\": {\n        \"title\": \"列表数据\",\n        \"type\": \"array\",\n        \"items\": {\n          \"title\": \"列项数据\",\n          \"type\": \"any\"\n        }\n      }\n    },\n    {\n      \"id\":\"empty\",\n      \"title\":\"切换到无内容\",\n      \"desc\":\"提示用户列表没有内容\",\n       \"schema\":{\n        \"title\":\"列表数据\",\n        \"type\":\"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [],\n  \"slots\": [\n    {\n      \"id\":\"emptySlot\",\n      \"title\":\"无内容插槽\"\n    },\n    {\n      \"id\": \"item\",\n      \"capacity\": 1,\n      \"title\": \"时间轴项\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"itemData\",\n          \"title\": \"当前项\",\n          \"description\": \"当前项展示内容\",\n          \"schema\": {\n            \"type\": \"any\"\n          }\n        },\n        {\n          \"id\": \"index\",\n          \"title\": \"当前项序号\",\n          \"description\": \"当前项展示的序号\",\n          \"schema\": {\n            \"type\": \"number\"\n          }\n        }\n      ]\n    }\n  ]\n}"
              },
              {
                "path": "src/components/timeLine/constant.ts",
                "content": "export enum Direction {\n  Column = 'column',\n  Row = 'row',\n}"
              },
              {
                "path": "src/components/timeLine/data.json",
                "content": "{\n  \"spacing\":0,\n  \"line_spacing\":false,\n  \"initialEmptyTip\":\"暂无内容\",\n  \"showEmptySlot\":false,\n  \"displaysEmptySpace\":false,\n  \"layout\": {\n    \"position\": \"smart\"\n  }\n}"
              },
              {
                "path": "src/components/timeLine/editors.tsx",
                "content": "export default {\n  \"@init\"({ style }) {\n    style.width = 375;\n    style.height = \"auto\";\n  },\n  \":slot\": {},\n  \"@resize\": {\n    options: [\"width\", \"height\"],\n  },\n  \":root\": {\n    style: [\n      {\n        title: \"点样式\",\n        options: [\"border\", \"background\", \"size\"],\n        target: \"#mybricks-dot\",\n      },\n      {\n        title: \"线样式\",\n        options: [\"background\", \"size\"],\n        target: \"#mybricks-line\",\n      },\n    ],\n    items: [\n      {\n        title: \"时间线断线\",\n        description: \"时间轴之间留白\",\n        type: \"switch\",\n        value: {\n          get({ data }) {\n            return data.line_spacing;\n          },\n          set({ data }, value) {\n            data.line_spacing = value;\n          },\n        },\n      },\n      {\n        title: \"内容间距\",\n        description: \"每个时间轴内容的垂直间距\",\n        type: \"text\",\n        options: {\n          type: \"number\",\n        },\n        value: {\n          get({ data }) {\n            return data.spacing;\n          },\n          set({ data }, value) {\n            data.spacing = value;\n          },\n        },\n      },\n      {\n        title:\"无内容时显示none\",\n        description: \"当时间轴为空时，显示无数据或者你自定义的插槽\",\n        type:\"switch\",\n        value: {\n          get({ data }) {\n            return data.displaysEmptySpace;\n          },\n          set({ data }, value) {\n            data.displaysEmptySpace = value;\n          },\n        }\n      },\n      {\n        catelogChange: {\n          value: {\n            get({ data }) {\n              return data._edit_status_;\n            },\n            set({ data, catelog }) {\n              data._edit_status_ = catelog;\n            },\n          },\n        },\n        items: [\n          {\n            title: \"\",\n            catelog: \"默认\",\n            type: \"editorRender\",\n            options: {\n              render: () => \"暂无\",\n            },\n          },\n          {\n            title: \"提示文案\",\n            type: \"text\",\n            catelog: \"无内容\",\n            value: {\n              get({ data }) {\n                return data.initialEmptyTip;\n              },\n              set({ data }, value) {\n                data.initialEmptyTip = value;\n              },\n            },\n          },\n          {\n            title: \"无内容插槽\",\n            type: \"switch\",\n            catelog: \"无内容\",\n            value: {\n              get({ data }) {\n                return data.showEmptySlot;\n              },\n              set({ data }, value) {\n                data.showEmptySlot = value;\n              },\n            },\n          },\n        ],\n      },\n    ],\n  },\n};\n"
              },
