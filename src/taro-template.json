                "content": "export default {\n  \"@init\"({ style }) {\n    style.width = \"100%\";\n    style.height = \"auto\";\n  },\n  \"@resize\": {\n    options: [\"width\", \"height\"],\n  },\n  \":root\"({ data, output, style }, cate0, cate1, cate2) {\n    cate0.title = \"常规\";\n    cate0.items = [\n      \n    ];\n\n    cate1.title = \"样式\";\n    cate1.items = [];\n\n    cate2.title = \"动作\";\n    cate2.items = [];\n  },\n};\n"
