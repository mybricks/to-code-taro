                  {
                    "path": "src/components/system/systemWebview/com.json",
                    "content": "{\n  \"title\": \"网页\",\n  \"namespace\": \"mybricks.taro.systemWebview\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"inputs\": [\n    {\n      \"id\": \"setUrl\",\n      \"title\": \"修改网页链接\",\n      \"desc\": \"可打开关联的公众号的文章，其它网页需登录小程序管理后台配置业务域名。\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onLoad\",\n      \"title\": \"网页加载成功时\",\n      \"schema\": {\n        \"type\": \"string\",\n        \"title\": \"网页链接\"\n      }\n    },\n    {\n      \"id\": \"onError\",\n      \"title\": \"网页加载失败时\",\n      \"schema\": {\n        \"type\": \"string\",\n        \"title\": \"网页链接\"\n      }\n    },\n    {\n      \"id\": \"onMessage\",\n      \"title\": \"网页向小程序 postMessage 时\",\n      \"schema\": {\n        \"type\": \"any\"\n      }\n    }\n  ]\n}\n"
                  },
                  {
                    "path": "src/components/system/systemWebview/data.json",
                    "content": "{\n  \"useNavigationStyle\": \"default\",\n  \"navigationStyle\": \"default\",\n  \"navigationBarBackgroundColor\": \"#464646\",\n  \"navigationBarTextStyle\": \"white\",\n  \"navigationBarTitleText\": \"网页标题\",\n  \"homeButton\": false,\n\n  \"url\": \"\"\n}"
                  },
                  {
                    "path": "src/components/system/systemWebview/editors.less",
                    "content": ".pagePath {\n  background: #ffffff;\n  border-radius: 4px;\n  border: 1px solid #d9d9d9;\n  height: 24px;\n  padding: 0 7px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  cursor: pointer;\n\n  .url {\n    font-size: 12px;\n    color: #434343;\n  }\n\n  .copy {\n    width: 16px;\n    height: 16px;\n    background: url(\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAADAAAAAwAQMAAABtzGvEAAAABlBMVEUAAABDQ0PjOoa6AAAAAXRSTlMAQObYZgAAADBJREFUGNNjIAXY//9/AIOyYGDEpBgwKeb///83YlANDMwUUv2YFAiRS4Fdhk4RDwCFTUQdZYYbsgAAAABJRU5ErkJggg==\")\n      no-repeat center center ~\"/\" contain;\n  }\n}\n\n.pageAlias {\n  background: #ffffff;\n  border-radius: 4px;\n  border: 1px solid #d9d9d9;\n  height: 24px;\n\n  .url {\n    font-size: 12px;\n    line-height: 22px;\n    color: #434343;\n    display: flex;\n    align-items: center;\n    height: 100%;\n    overflow: hidden;\n\n    &::before {\n      content: \"/pages/\";\n      background: rgba(0, 0, 0, 0.02);\n      padding: 0 7px;\n      border-right: 1px solid #d9d9d9;\n    }\n    &::after {\n      content: \"/index\";\n      background: rgba(0, 0, 0, 0.02);\n      padding: 0 7px;\n      border-left: 1px solid #d9d9d9;\n    }\n\n    .input {\n      flex: 1;\n      height: 100%;\n      border: none;\n      border-radius: 0;\n      padding: 0 4px;\n      font-size: 12px;\n      outline: none;\n    }\n  }\n}\n"
                  },
                  {
                    "path": "src/components/system/systemWebview/editors.tsx",
                    "content": "import entryPagePathEditor from \"./editors/entryPagePath\";\nimport MybricksNavigationEditor from \"./editors/mybricks-navigation\";\n\nexport default {\n  \":root\"({ data, output, style }, cate0, cate1, cate2) {\n    cate0.title = \"常规\";\n    cate0.items = [\n      { ...entryPagePathEditor },\n      {\n        title: \"导航栏\",\n        items: [\n          {\n            title: \"导航栏背景颜色\",\n            type: \"colorpicker\",\n            value: {\n              get({ data }) {\n                return data.navigationBarBackgroundColor;\n              },\n              set({ data }, value) {\n                data.navigationBarBackgroundColor = value;\n              },\n            },\n          },\n          {\n            title: \"导航栏标题颜色\",\n            type: \"radio\",\n            options: [\n              {\n                label: \"黑色\",\n                value: \"black\",\n              },\n              {\n                label: \"白色\",\n                value: \"white\",\n              },\n            ],\n            value: {\n              get({ data }) {\n                return data.navigationBarTextStyle;\n              },\n              set({ data }, value) {\n                data.navigationBarTextStyle = value;\n              },\n            },\n          },\n          // {\n          //   title: \"导航栏标题文字内容\",\n          //   type: \"text\",\n          //   value: {\n          //     get({ data }) {\n          //       return data.navigationBarTitleText;\n          //     },\n          //     set({ data }, value) {\n          //       data.navigationBarTitleText = value;\n          //     },\n          //   },\n          // },\n          {\n            title:\n              \"在非首页、非页面栈最底层页面或非tabbar内页面中的导航栏展示home键\",\n            type: \"switch\",\n            value: {\n              get({ data }) {\n                return data.homeButton;\n              },\n              set({ data }, value) {\n                data.homeButton = value;\n              },\n            },\n          },\n        ],\n      },\n      {\n        title: \"\",\n        items: [\n          {\n            title: \"网页链接\",\n            type: \"text\",\n            description:\n              \"可打开关联的公众号的文章，其它网页需登录小程序管理后台配置业务域名。\",\n            value: {\n              get({ data }) {\n                return data.url;\n              },\n              set({ data }, value: string) {\n                data.url = value;\n              },\n            },\n          },\n        ],\n      },\n      {\n        title: \"事件\",\n        items: [\n          {\n            title: \"网页加载成功时\",\n            type: \"_event\",\n            options: {\n              outputId: \"onLoad\",\n            },\n          },\n          {\n            title: \"网页加载失败时\",\n            type: \"_event\",\n            options: {\n              outputId: \"onError\",\n            },\n          },\n          {\n            title: \"网页向小程序 postMessage 时\",\n            type: \"_event\",\n            options: {\n              outputId: \"onMessage\",\n            },\n          },\n        ],\n      },\n    ];\n  },\n};\n"
                  },
                  {
