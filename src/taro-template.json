                "content": "<?xml version=\"1.0\" standalone=\"no\"?><!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\"><svg t=\"1713875311600\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"7630\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"128\" height=\"128\"><path d=\"M209.92 0q25.6 0 43.008 17.408t17.408 43.008V209.92q0 25.6-17.408 43.008t-43.008 17.408H60.416q-25.6 0-43.008-17.408T0 209.92V60.416q0-25.6 17.408-43.008T60.416 0H209.92z m362.496 603.136q25.6 0 43.008 17.408t17.408 43.008v301.056q0 24.576-17.408 41.984T572.416 1024H421.888q-25.6 0-43.008-17.408t-17.408-41.984V663.552q0-25.6 17.408-43.008t43.008-17.408h150.528zM209.92 330.752q25.6 0 43.008 17.92t17.408 42.496v573.44q0 24.576-17.408 41.984T209.92 1024H60.416q-25.6 0-43.008-17.408T0 964.608v-573.44q0-24.576 17.408-42.496t43.008-17.92H209.92zM933.888 0q25.6 0 43.008 17.408t17.408 43.008v301.056q0 24.576-17.408 42.496t-43.008 17.92H784.384q-25.6 0-43.008-17.92t-17.408-42.496V60.416q0-25.6 17.408-43.008T784.384 0h149.504z m0 481.28q25.6 0 43.008 17.92t17.408 43.52v421.888q0 24.576-17.408 41.984T933.888 1024H784.384q-25.6 0-43.008-17.408t-17.408-41.984V542.72q0-25.6 17.408-43.52t43.008-17.92h149.504zM572.416 0q25.6 0 43.008 17.408t17.408 43.008V481.28q0 25.6-17.408 43.52t-43.008 17.92H421.888q-25.6 0-43.008-17.92t-17.408-43.52V60.416q0-25.6 17.408-43.008T421.888 0h150.528z\" fill=\"#555555\" p-id=\"7631\"></path></svg>"
