                "path": "src/components/formStepper/ai.ts",
                "content": "\nexport default {\n  ':root' ({ data }) {\n    return {}\n  },\n  prompts: {\n    summary: '数字输入，左侧减图标，中间输入，右侧加图标的数字输入框',\n    usage: `数字输入，左侧减图标，中间输入，右侧加图标的数字输入框\n    \nschema=mybricks.taro.formContainer/formItem\n\nstyleAry声明\n增加按钮:\n  - 默认样式：\n    - color: #ffffff\n    - borderRadius: 100%\n    - borderColor: #fa6400\n    - backgroundColor: #fa6400\n    - height: 40px\n    - width: 40px\n  - 可编辑样式: color、border、background、borderRadius相关\n减少按钮\n  - 默认样式：\n    - color: #fa6400\n    - borderRadius: 100%\n    - borderColor: #fa6400\n    - backgroundColor: #ffffff\n    - height: 40px\n    - width: 40px\n  - 可编辑样式: color、border、background、borderRadius相关\n中间的数字文本\n  - 默认样式：\n    - color: #000000\n  - 可编辑样式: color\n\nlayout声明\nwidth: 可配置\nheight: 不可配置，默认为fit-content`\n  },\n  modifyTptJson: (component) => {\n    \n  }\n}"
              },
              {
                "path": "src/components/formStepper/com.json",
                "content": "{\n  \"title\": \"数字输入\",\n  \"namespace\": \"mybricks.taro.formStepper\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.0\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/j864I8a0yIhYIY1XFNhGW5MqmAnSH1vR-1743580565071.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置表单项值\",\n      \"schema\": {\n        \"type\": \"number\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取表单项值并输出\",\n      \"schema\": {\n        \"type\": \"number\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空数字输入的值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
