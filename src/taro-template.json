                "children": [
                  {
                    "path": "src/components/components-h5/swiper/index.less",
                    "content": ".wrapper {\n  position: relative !important;\n  width: 100%;\n  overflow: hidden;\n  // height: 100%;\n\n  :global {\n    .indicators {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      bottom: 10px;\n      display: flex;\n      align-items: center;\n      z-index: 999;\n\n      .indicator {\n        width: 6px;\n        height: 6px;\n        border-radius: 50%;\n\n        margin: 0 3px;\n\n        background-color: rgb(235, 237, 240);\n\n        &.indicator-active {\n          background-color: rgb(25, 137, 250);\n        }\n      }\n    }\n  }\n}"
