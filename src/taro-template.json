                    "path": "src/components/components-h5/skeleton-image/index.less",
                    "content": ".com{\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  overflow: hidden;\n}\n\n.place {\n  position: absolute;\n  top: 0px;\n  left: 0px;\n  right: 0px;\n  bottom: 0px;\n  opacity: 1;\n  background: #f0f0f0;\n  transition: all 0.3s ease-in-out;\n  z-index: 3;\n\n  &.none {\n    z-index: -1;\n    opacity: 0;\n  }\n}"
                  },
                  {
                    "path": "src/components/components-h5/skeleton-image/index.tsx",
                    "content": "import React, {\n  useCallback,\n  useEffect,\n  useRef,\n  useMemo,\n  useState,\n} from \"react\";\nimport css from \"./index.less\";\nimport { ImageProps } from \"@tarojs/components\";\nimport Image from './../image'\nimport View from './../view'\n\ninterface SkeletonImageProps extends ImageProps {\n  skeleton?: boolean \n}\n\nexport default function ({ skeleton = false, onLoad, onClick, onError, className, src, mode, ...props }: SkeletonImageProps) {\n  const [loading, setLoading] = useState(!!skeleton)\n\n  useEffect(() => {\n    if (src && skeleton) {\n      setLoading(true)\n    }\n  }, [src, skeleton])\n\n  const _onLoad = useCallback((e) => {\n    setLoading(false)\n    onLoad?.(e);\n  }, [onLoad]);\n\n  const _onClick = useCallback((e) => {\n    onClick?.(e);\n  }, [onClick]);\n\n  const _onError = useCallback((e) => {\n    setLoading(false)\n    onError?.(e)\n  }, [onError]);\n\n  return (\n    <View className={css.com}>\n      <View className={loading ? `${css.place}` : `${css.place} ${css.none}`}></View>\n      <Image\n        {...props}\n        className={className}\n        src={src}\n        mode={mode}\n        onClick={_onClick}\n        onLoad={_onLoad}\n        onError={_onError}\n      />\n    </View>\n  );\n}\n"
                  }
                ]
