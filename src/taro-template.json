 3.968 4.864 1.792 2.56 3.008 5.504 1.152 2.944 1.792 6.016 0.64 3.072 0.64 6.272 0 3.136-0.64 6.208-0.64 3.136-1.792 6.016-1.28 2.944-3.008 5.504-1.728 2.624-3.968 4.864-2.24 2.24-4.864 3.968-2.56 1.792-5.504 3.008-2.88 1.152-6.016 1.792-3.072 0.64-6.208 0.64z m32-32q0 3.136-0.64 6.208-0.64 3.136-1.792 6.016-1.28 2.944-3.008 5.504-1.728 2.624-3.968 4.864-2.24 2.24-4.864 3.968-2.56 1.792-5.504 3.008-2.88 1.152-6.016 1.792-3.072 0.64-6.208 0.64-3.2 0-6.272-0.64t-6.016-1.792q-2.88-1.28-5.504-3.008-2.624-1.728-4.864-3.968-2.24-2.24-3.968-4.864-1.728-2.56-2.944-5.504-1.28-2.88-1.856-6.016-0.64-3.072-0.64-6.208 0-3.2 0.64-6.272t1.856-6.016q1.216-2.88 2.944-5.504 1.728-2.624 3.968-4.864 2.24-2.24 4.864-3.968 2.56-1.728 5.504-2.944 2.944-1.28 6.016-1.856 3.072-0.64 6.272-0.64 3.136 0 6.208 0.64 3.136 0.64 6.016 1.856 2.944 1.216 5.504 2.944 2.624 1.728 4.864 3.968 2.24 2.24 3.968 4.864 1.792 2.56 3.008 5.504 1.152 2.944 1.792 6.016 0.64 3.072 0.64 6.272z m-170.688 0q0 3.136-0.64 6.208-0.64 3.136-1.792 6.016-1.216 2.944-2.944 5.504-1.792 2.624-3.968 4.864-2.24 2.24-4.864 3.968-2.624 1.792-5.568 3.008-2.88 1.152-5.952 1.792-3.136 0.64-6.272 0.64-3.2 0-6.272-0.64t-5.952-1.792q-2.944-1.28-5.568-3.008-2.56-1.728-4.864-3.968-2.176-2.24-3.968-4.864-1.728-2.56-2.944-5.504-1.216-2.88-1.792-6.016-0.64-3.072-0.64-6.208 0-3.2 0.64-6.272t1.792-6.016q1.216-2.88 2.944-5.504 1.792-2.624 3.968-4.864 2.24-2.24 4.864-3.968 2.624-1.728 5.568-2.944 2.88-1.28 5.952-1.856 3.136-0.64 6.272-0.64 3.2 0 6.272 0.64t5.952 1.856q2.944 1.216 5.568 2.944 2.56 1.728 4.864 3.968 2.176 2.24 3.968 4.864 1.728 2.56 2.944 5.504 1.216 2.944 1.792 6.016 0.64 3.072 0.64 6.272z\" p-id=\"1507\" fill=\"#555555\"></path></svg>"
