                "path": "src/components/dropdownForm/com.json",
                "content": "{\n  \"title\": \"下拉表单容器\",\n  \"namespace\": \"mybricks.taro.dorpdownForm\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.1\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"inputs\": [\n    {\n      \"id\": \"setFieldsValue\",\n      \"title\": \"设置表单数据\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      },\n      \"desc\": \"给表单设置数据\"\n    },\n    {\n      \"id\": \"getFieldsValue\",\n      \"title\": \"获取表单数据\",\n      \"rels\": [\"returnValues\"],\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"desc\": \"获取表单数据\"\n    },\n    {\n      \"id\": \"resetFields\",\n      \"title\": \"重置表单\",\n      \"rels\": [\"onReset\"],\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"desc\": \"触发表单所有字段进行重置\"\n    },\n    {\n      \"id\": \"closePopup\",\n      \"title\": \"关闭当前弹出项\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      },\n      \"desc\": \"关闭当前弹出项\"\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"returnValues\",\n      \"title\": \"表单数据输出\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"id\": \"onSubmit\",\n      \"title\": \"提交数据输出\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"id\": \"onMergeSubmit\",\n      \"title\": \"提交数据输出\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {}\n      }\n    },\n    {\n      \"id\": \"onReset\",\n      \"title\": \"重置完成\"\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"u_item1\",\n      \"capacity\": 1,\n      \"title\": \"智能排序\",\n      \"type\": \"scope\",\n      \"schema\": \"mybricks.taro.formContainer/formItem\",\n      \"inputs\": [\n        {\n          \"id\": \"setFieldsValue\",\n          \"title\": \"表单数据输入\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {}\n          }\n        }\n      ],\n      \"_inputs\": [\n        {\n          \"id\": \"onChange\",\n          \"title\": \"表单项值变化\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\",\n                \"title\": \"组件ID\"\n              },\n              \"value\": {\n                \"type\": \"any\",\n                \"title\": \"组件值\"\n              }\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"u_item2\",\n      \"capacity\": 1,\n      \"title\": \"分类\",\n      \"type\": \"scope\",\n      \"schema\": \"mybricks.taro.formContainer/formItem\",\n      \"inputs\": [\n        {\n          \"id\": \"setFieldsValue\",\n          \"title\": \"表单数据输入\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {}\n          }\n        }\n      ],\n      \"_inputs\": [\n        {\n          \"id\": \"onChange\",\n          \"title\": \"表单项值变化\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\",\n                \"title\": \"组件ID\"\n              },\n              \"value\": {\n                \"type\": \"any\",\n                \"title\": \"组件值\"\n              }\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"u_item23\",\n      \"capacity\": 1,\n      \"title\": \"全部筛选\",\n      \"type\": \"scope\",\n      \"schema\": \"mybricks.taro.formContainer/formItem\",\n      \"inputs\": [\n        {\n          \"id\": \"setFieldsValue\",\n          \"title\": \"表单数据输入\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {}\n          }\n        }\n      ],\n      \"_inputs\": [\n        {\n          \"id\": \"onChange