                    "content": "<?xml version=\"1.0\" standalone=\"no\"?><!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\"><svg t=\"1684829026490\" class=\"icon\" viewBox=\"0 0 1024 1024\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" p-id=\"14889\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"128\" height=\"128\"><path d=\"M980.057204 226.907329c20.461517-70.592234 26.599972-207.684399-99.238358-225.076688-101.28451-13.811524-221.495923 53.711482-284.415088 95.657592-21.996131-3.069228-43.480724-4.603841-65.476855-5.115379-164.203675-2.046152-271.115102 53.711482-361.657315 171.876744-33.761503 43.992262-63.430703 118.165261-72.638385 201.545943 46.549951-79.288379 186.199806-222.518999 336.080418-281.34586 0 0-225.076688 160.622909-335.057343 390.303439l-0.511537 0.511538c0 1.023076 0 2.046152 0.511537 3.580765-4.603841 10.230759-9.719221 20.973055-13.811524 31.715352-109.980654 269.580488-19.949979 386.722673 61.89609 408.207266C221.446457 1038.71802 327.846346 1001.375752 412.761642 910.833538c144.765234 33.761503 287.484315-4.092303 341.707336-33.761503 101.796048-55.757634 170.853668-154.484454 187.222881-255.768964h-277.765094s-11.765372 89.519137-160.62291 89.519138c-137.092165 0-143.23062-159.088296-143.23062-159.088296h589.803231s11.253834-171.365206-73.661461-285.438164C829.153515 202.353508 765.211274 146.595874 675.692137 116.415137c27.623048-19.949979 74.684537-51.665331 114.584496-61.89609 75.707613-19.949979 127.372944-8.184607 159.599833 47.06149 43.992262 74.684537-24.042283 249.630509-24.042282 249.630508s33.249965-50.642255 54.22302-124.303716zM370.303994 898.04509c-116.630648 95.146055-213.822854 84.403758-251.165123 27.11151-32.226889-50.130717-38.365345-139.649854 0-261.907419 18.926903 50.642255 48.596103 96.16913 86.961448 134.022937 46.549951 46.038414 102.307586 80.311455 164.203675 100.772972zM366.211691 404.41099s5.626917-112.538344 128.396019-122.769103c106.911427-8.6961