              {
                "path": "src/components/cell/runtime.tsx",
                "content": "import React, {\n  useCallback,\n  useEffect,\n  useMemo,\n  useState,\n  useRef,\n} from \"react\";\nimport { View, Image } from \"@tarojs/components\";\nimport { Arrow } from \"@taroify/icons\";\nimport css from \"./style.less\";\nimport cx from \"classnames\";\n\nexport default function ({ env, data, slots, inputs, outputs }) {\n  const touchStartX = useRef(0);\n  const touchStartY = useRef(0);\n  const translateXRef = useRef(0);\n  const SWIPE_THRESHOLD = 30; // 滑动阈值\n  const [cellStyle, setCellStyle] = useState({\n    transform: `translateX(0px)`,\n  });\n\n  inputs[\"value\"]((val) => {\n    Object.keys(val).forEach((key) => {\n      data[key] = val[key];\n    });\n  });\n\n\n  useEffect(() => {\n    inputs?.[\"swipe\"]?.((val) => {\n        data.useSwipeLeft = !!val\n    })\n  }, [])\n\n  const onClick = useCallback(\n    (raw) => {\n      if (!env.runtime) {\n        return;\n      }\n      outputs[\"onClick\"](raw);\n    },\n    [env]\n  );\n\n  const onClickLeftAction = useCallback((raw) => {\n    if (!env.runtime) {\n      return;\n    }\n    outputs[\"onClickLeftAction\"](raw);\n  }, []);\n\n  const onClickLeftActionSecondary = useCallback((raw) => {\n    if (!env.runtime) {\n      return;\n    }\n    outputs[\"onClickLeftActionSecondary\"](raw);\n  }, []);\n\n  const onTouchStart = useCallback(\n    (e) => {\n      if (!data.useSwipeLeft) {\n        return;\n      }\n      touchStartX.current = e.touches[0].clientX;\n      touchStartY.current = e.touches[0].clientY;\n    },\n    [data.useSwipeLeft]\n  );\n\n  const onTouchMove = useCallback(\n    (e) => {\n      if (!data.useSwipeLeft) {\n        return;\n      }\n\n      const touche = e.touches[0];\n      let deltaX = touche.clientX - touchStartX.current;\n      let deltaY = touche.clientY - touchStartY.current;\n\n      // console.log(\"deltaX\",deltaX,\"SWIPE_THRESHOLD\",SWIPE_THRESHOLD,\"deltaY\",deltaY)\n\n      // 只有水平滑动距离超过阈值，且大于垂直滑动距离时才处理\n      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {\n        e.preventDefault();\n        e.stopPropagation();\n\n        // 右滑，且已经在最右边\n        if (translateXRef.current === 0 && deltaX > 0) {\n          return;\n        }\n\n        if (translateXRef.current <= -(data.leftSwipeWidth + data.leftSwipeWidthSecondary) && deltaX < 0) {\n          return;\n        }\n\n        let result = deltaX + translateXRef.current;\n        if (result > 0) {\n          result = 0;\n        } else if (result < -(data.leftSwipeWidth + data.leftSwipeWidthSecondary)) {\n          result = -(data.leftSwipeWidth + data.leftSwipeWidthSecondary);\n        }\n\n        setCellStyle({\n          transform: `translateX(${result}px)`,\n        });\n      }\n    },\n    [data.useSwipeLeft, data.leftSwipeWidth, data.leftSwipeWidthSecondary]\n  );\n\n  const onTouchEnd = useCallback(\n    (e) => {\n      if (!data.useSwipeLeft) {\n        return;\n      }\n\n      let touche = e.changedTouches[0];\n\n      if (touche.clientX >= touchStartX.current) {\n        translateXRef.current = 0;\n        setCellStyle({\n          transform: `translateX(0px)`,\n          transition: \"transform 0.3s\",\n        });\n      } else {\n        translateXRef.current = -(parseInt(data.leftSwipeStyle.width) + parseInt(data.leftSwipeStyleSecondary.width));\n        setCellStyle({\n          transform: `translateX(${-(parseInt(data.leftSwipeStyle.width) + parseInt(data.leftSwipeStyleSecondary.width))}px)`,\n          transition: \"transform 0.3s\",\n        });\n      }\n    },\n    [data.useSwipeLeft, data.leftSwipeStyle.width, data.leftSwipeStyleSecondary.width]\n  );\n\n  return (\n    <View className={css.swipeCell}>\n      <View\n        className={cx(css.cell, \"mybricks-cell\")}\n        style={{ ...cellStyle }}\n        onClick={(e) => {\n          if (env.runtime) {\n            e.stopPropagation();\n          }\n          setCellStyle({\n            transform: `translateX(0px)`,\n            transition: \"transform 0.3s\",\n          });\n          onClick({ title: data.title });\n        }}\n        onTouchStart={onTouchStart}\n        onTouchMove={onTouchMove}\n        onTouchEnd={onTouchEnd}\n      >\n        {data.useThumb && data.thumb ? (\n          <Image\n            className={cx(css.thumb, \"mybricks-thumb\")}\n            mode=\"scaleToFill\"\n            src={data.thumb}\n          />\n        ) : null}\n        <View className={cx(css.inner)}>\n          {data.title || data.brief ? (\n            <View className={css.label}>\n              {data.title ? (\n                <View className={cx(css.title, \"mybricks-title\")}>\n                  {data.title}\n                </View>\n              ) : null}\n\n              {data.brief ? (\n                <View className={cx(css.brief, \"mybricks-brief\")}>\n                  {data.brief}\n                </View>\n              ) : null}\n            </View>\n          ) : null}\n\n          <View\n            className={cx(css.content, {\n              \"mybricks-content\": !data.useChildren,\n              \"mybricks-children\": data.useChildren,\n            })}\n          >\n            <View className={css.contentInner}>\n              {data.useChildren\n                ? slots[\"children\"]?.render?.({\n                  style: {\n                    ...data.slotStyle,\n                    minHeight: \"12\",\n                  },\n                })\n                : data.content}\n            </View>\n          </View>\n          {data.useArrowIcon ? (\n            <View className={css.arrow}>\n              <Arrow\n                className={css.icon}\n                style={\n                  data.useChildren && data.useArrowIcon\n                    ? { color: data.arrowIconColor }\n                    : {}\n                }\n              />\n            </View>\n          ) : null}\n        </View>\n      </View>\n\n      <View\n        className={css.action}\n        style={{\n          ...data.leftSwipeStyleSecondary,\n          right: `${data.leftSwipeStyle?.width ?? 50}px`\n        }}\n        onClick={(e) => {\n          if (env.runtime) {\n            e.stopPropagation();\n          }\n          setCellStyle({\n            transform: `translateX(0px)`,\n            transition: \"transform 0.3s\",\n          });\n          onClickLeftActionSecondary({ title: data.title });\n        }}\n      >\n        {data.leftSwipeTextSecondary}\n      </View>\n      <View\n        className={css.action}\n        style={{\n          ...data.leftSwipeStyle\n        }}\n        onClick={(e) => {\n          if (env.runtime) {\n            e.stopPropagation();\n          }\n          setCellStyle({\n            transform: `translateX(0px)`,\n            transition: \"transform 0.3s\",\n          });\n          onClickLeftAction({ title: data.title });\n        }}\n      >\n        {data.leftSwipeText}\n      </View>\n    </View>\n  );\n}"
              },
              {
                "path": "src/components/cell/style.less",
                "content": ".cell {\n  display: flex;\n  align-items: center;\n  padding: 12px 16px;\n  border-bottom: 1px solid #f8f8f8;\n  height: 100%;\n  background: #ffffff;\n  position: relative;\n  z-index: 10;\n\n  .thumb {\n    display: block;\n    width: 42px;\n    height: 42px;\n    margin-right: 12px;\n  }\n\n  .inner {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    position: relative;\n    // padding-top: 12px;\n    // padding-bottom: 12px;\n    // padding-right: 16px;\n\n    // &::after {\n    //   content: \"\";\n    //   display: block;\n    //   width: 100%;\n    //   height: 1px;\n    //   background: #ebedf0;\n    //   position: absolute;\n    //   left: 0;\n    //   bottom: 0;\n    // }\n  }\n\n  .label {\n    margin-right: 12px;\n  }\n\n  .title {\n    color: #323233;\n    font-size: 14px;\n    line-height: 20px;\n  }\n\n  .brief {\n    margin-top: 4px;\n    color: #969799;\n    font-size: 12px;\n    line-height: 18px;\n  }\n\n  .content {\n    flex: 1;\n    color: #969799;\n    font-size: 14px;\n    line-height: 20px;\n    text-align: right;\n    display: flex;\n    align-items: center;\n\n    .contentInner {\n      flex: 1;\n    }\n\n    .arrow {\n      margin-left: 12px;\n      display: flex;\n      align-items: center;\n      height: 100%;\n\n      .icon {\n        font-size: 14px;\n      }\n    }\n  }\n}\n\n.swipeCell {\n  position: relative;\n  .action {\n    position: absolute;\n    top: 0;\n    right: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    height: 100%;\n    color: #ffffff;\n    font-weight: 500;\n    font-size: 16px;\n  }\n}\n"
              }
            ]
          },
          {
            "path": "src/components/channelVideo",
            "content": null,
            "children": [
              {
                "path": "src/components/channelVideo/com.json",
                "content": "{\n  \"title\": \"微信视频号\",\n  \"namespace\": \"mybricks.taro.channelVideo\",\n  \"version\": \"1.0.0\",\n  \"description\": \"内嵌显示微信视频号\",\n  \"author\": \"MyBricks\",\n  \"author_name\": \"MyBricks\",\n  \"icon\": \"./icon.svg\",\n  \"data\": \"./data.json\",\n  \"runtime\": \"./runtime.tsx\",\n  \"editors\": \"./editors.tsx\",\n  \"inputs\": [\n    {\n      \"id\": \"channelVideo\",\n      \"title\": \"视频号参数\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"feedId\": {\n            \"type\": \"string\",\n            \"title\": \"视频Id(必填)\",\n            \"description\": \"视频Id(必填)\"\n          },\n          \"finderUserName\": {\n            \"type\": \"string\",\n            \"title\": \"视频号Id(必填)\",\n            \"description\": \"视频号Id(必填)\"\n          },\n          \"loop\": {\n            \"type\": \"boolean\",\n            \"title\": \"是否循环播放(可选)\",\n            \"description\": \"是否循环播放(可选)\"\n          },\n          \"muted\": {\n            \"type\": \"boolean\",\n            \"title\": \"是否静音播放(可选)\",\n            \"description\": \"是否静音播放(可选)\"\n          },\n          \"objectFit\": {\n            \"type\": \"string\",\n            \"title\": \"视频缩放模式(可选)\",\n            \"description\": \"视频缩放模式(可选) 枚举:fill contain cover\"\n          },\n          \"autoplay\": {\n            \"type\": \"boolean\",\n            \"title\": \"是否自动播放(可选)\",\n            \"description\": \"是否自动播放(可选)\"\n          },\n          \"feedToken\": {\n            \"type\": \"string\",\n            \"title\": \"视频token(可选)\",\n            \"description\": \"仅内嵌小程序非同主体视频号视频时使用(可选)\"\n          }\n        }\n      }\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onError\",\n      \"title\": \"错误\",\n      \"schema\": {\n        \"type\": \"follow\"\n      }\n    }\n  ]\n}"
              },
