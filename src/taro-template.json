              },
              {
                "path": "src/components/formImageUploader/com.json",
                "content": "{\n  \"title\": \"图片上传\",\n  \"namespace\": \"mybricks.taro.formImageUploader\",\n  \"author\": \"mybricks-team\",\n  \"author_name\": \"板砖团队\",\n  \"version\": \"1.0.3\",\n  \"runtime\": \"./runtime.tsx\",\n  \"data\": \"./data.json\",\n  \"editors\": \"./editors.tsx\",\n  \"icon\": \"./icon.svg\",\n  \"preview\": \"https://assets.mybricks.world/nMzIVC8kVvHhZc2vbNwyB8mHGqSgfI1n-1743579771754.png\",\n  \"ai\": \"./ai.ts\",\n  \"inputs\": [\n    {\n      \"id\": \"setValue\",\n      \"title\": \"设置值\",\n      \"desc\": \"设置值，并触发值变化事件输出\",\n      \"schema\": {\n        \"type\": \"array\"\n      },\n      \"rels\": [\"setValueComplete\"]\n    },\n    {\n      \"id\": \"getValue\",\n      \"title\": \"获取值\",\n      \"desc\": \"获取值并输出\",\n      \"schema\": {\n        \"type\": \"array\"\n      },\n      \"rels\": [\"returnValue\"]\n    },\n    {\n      \"id\": \"resetValue\",\n      \"title\": \"重置值\",\n      \"desc\": \"清空值\",\n      \"schema\": {\n        \"type\": \"any\"\n      },\n      \"rels\": [\"resetValueComplete\"]\n    },\n    {\n      \"id\": \"setLabel\",\n      \"title\": \"设置标题\",\n      \"desc\": \"设置表单项标题，仅当表单项在表单容器内时生效\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setPlaceholder\",\n      \"title\": \"设置提示内容\",\n      \"desc\": \"设置图片上传下方的文本提示内容\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabled\",\n      \"title\": \"设置是否禁用\",\n      \"desc\": \"设置表单项是否禁用，传入 true 时禁用表单项，传入 false 时启用表单项\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"setMaxCount\",\n      \"title\": \"设置最大上传数量\",\n      \"desc\": \"设置最大上传数量，传入 0 时表示不限制\",\n      \"schema\": {\n        \"type\": \"number\"\n      },\n      \"rels\": [\"setMaxCountComplete\"]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"id\": \"onChange\",\n      \"title\": \"当值变化\",\n      \"schema\": {\n        \"type\": \"array\"\n      }\n    },\n    {\n      \"id\": \"setValueComplete\",\n      \"title\": \"设置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"returnValue\",\n      \"title\": \"值输出\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"resetValueComplete\",\n      \"title\": \"重置值完成\",\n      \"schema\": {\n        \"type\": \"string\"\n      }\n    },\n    {\n      \"id\": \"setDisabledComplete\",\n      \"title\": \"是否禁用设置完成\",\n      \"schema\": {\n        \"type\": \"boolean\"\n      }\n    },\n    {\n      \"id\": \"setMaxCountComplete\",\n      \"title\": \"设置最大上传数量完成\",\n      \"schema\": {\n        \"type\": \"number\"\n      }\n    }\n  ],\n  \"slots\": [\n    {\n      \"id\": \"customUpload\",\n      \"title\": \"逐张图片上传处理\",\n      \"type\": \"scope\",\n      \"inputs\": [\n        {\n          \"id\": \"fileData\",\n          \"title\": \"输出图片本地文件路径\",\n          \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"filePath\": {\n                \"type\": \"string\",\n                \"description\": \"本地临时文件路径\"\n              },\n              \"size\": {\n                \"type\": \"number\",\n                \"description\": \"本地文件大小，单位 B\"\n              },\n              \"fileName\": {\n                \"type\": \"string\",\n                \"description\": \"原始文件名称，仅在 H5 环境下有效\"\n              },\n              \"type\": {\n                \"type\": \"string\",\n                \"description\": \"原始文件类型，仅在 H5 环境下有效\"\n              },\n              \"formData\": {\n                \"type\": \"any\",\n                \"description\": \"表单项数据，仅在 H5 环境下有效\"\n              }\n            }\n          }\n        }\n      ],\n      \"outputs\": [\n        {\n          \"id\": \"setFileInfo\",\n          \"title\": \"设置图片上传后地址\",\n          \"schema\": {\n            \"type\": \"string\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"iconSlot\",\n      \"title\": \"占位插槽\"\n    }\n  ],\n  \"schema\": [\"mybricks.taro.formContainer/formItem\", \"*\"]\n}\n"
              },
              {
                "path": "src/components/formImageUploader/data.json",
                "content": "{\n  \"label\": \"图片上传\",\n  \"name\": \"图片上传\",\n  \"value\": [],\n  \"maxCount\": 2,\n  \"useValueString\": false,\n  \"placeholderText\": \"\",\n  \"placeholder\": \"\",\n  \"required\": false,\n  \"chooseAvatar\": false,\n  \"compressImage\": false,\n  \"compressQuality\": 0.7,\n  \"disabled\": false\n}\n"
              },
              {
                "path": "src/components/formImageUploader/editors.tsx",
                "content": "export default {\n  \"@init\": ({ style, data }) => {\n    style.width = \"100%\";\n    style.height = \"auto\";\n  },\n  \"@resize\": {\n    options: [\"width\"],\n  },\n  \":slot\": {},\n  \":root\": {\n    style: [\n      {\n        title: \"卡片尺寸\",\n        options: [\"size\", \"border\", \"background\"],\n        target: \".mybricks-square\",\n      },\n    ],\n    items: ({ data, output, style }, cate0, cate1, cate2) => {\n      cate0.title = \"图片上传\";\n      cate0.items = [\n        {\n          title: \"基础属性\",\n          items: [\n            {\n              title: \"最大上传数量\",\n              description: \"最多可以上传的图片数量\",\n              type: \"text\",\n              options: {\n                plugins: [\"number\"],\n              },\n              value: {\n                get({ data }) {\n                  return data.maxCount;\n                },\n                set({ data }, value) {\n                  data.maxCount = value;\n                },\n              },\n            },\n            {\n              title: \"提示内容\",\n              description: \"上传图片下方显示的提示文案\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.placeholderText;\n                },\n                set({ data }, value) {\n                  data.placeholderText = value;\n                },\n              },\n            },\n            {\n              title: \"上传name(h5生效)\",\n              description: \"上传图片时，后端接收的参数名\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.uploadName;\n                },\n                set({ data }, value) {\n                  data.uploadName = value;\n                },\n              },\n            },\n            {\n              title: \"上传filename(h5生效)\",\n              description: \"上传图片时，后端接收的文件名参数名\",\n              type: \"text\",\n              value: {\n                get({ data }) {\n                  return data.uploadFileName;\n                },\n                set({ data }, value) {\n                  data.uploadFileName = value;\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"高级属性\",\n          items: [\n            {\n              title: \"示例图\",\n              description: \"上传图片右侧显示的示例图\",\n              type: \"imageSelector\",\n              options: {\n                fileSizeLimit: 2,\n              },\n              value: {\n                get({ data }) {\n                  return data.placeholder;\n                },\n                set({ data }, value) {\n                  data.placeholder = value;\n                },\n              },\n            },\n            {\n              title: \"支持获取微信头像\",\n              description: \"是否支持用户选择微信头像\",\n              type: \"Switch\",\n              value: {\n                get({ data }) {\n                  return data.chooseAvatar;\n                },\n                set({ data }, value) {\n                  data.chooseAvatar = value;\n                },\n              },\n            },\n            {\n              title: \"开启占位插槽\",\n              description: \"是否开启占位插槽, 用于自定义上传按钮\",\n              type: \"Switch\",\n              value: {\n                get({ data }) {\n                  return data.iconSlot;\n                },\n                set({ data }, value) {\n                  data.iconSlot = value;\n                },\n              },\n            },\n            {\n              title: \"格式化为字符串\",\n              description: \"仅在最大上传数量为1时有效\",\n              type: \"switch\",\n              value: {\n                get({ data }) {\n                  return data.useValueString;\n                },\n                set({ data }, value) {\n                  data.useValueString = value;\n                },\n              },\n            },\n            {\n              title: \"是否压缩图片(h5生效)\",\n              description: \"是否压缩上传的图片\",\n              type: \"switch\",\n              value: {\n                get({ data }) {\n                  return data.compressImage;\n                },\n                set({ data }, value: boolean) {\n                  data.compressImage = value;\n                },\n              },\n            },\n            {\n              title: \"压缩质量\",\n              type: \"Inputnumber\",\n              description:\n                \"图片压缩质量, 数值越小, 图片质量越差, 但文件体积更小\",\n              options: [{ min: 0.1, max: 1 }],\n              ifVisible({ data }: EditorResult<Data>) {\n                return !!data.compressImage;\n              },\n              value: {\n                get({ data }: EditorResult<Data>) {\n                  return [data.compressQuality || 0.7];\n                },\n                set({ data }: EditorResult<Data>, value: number[]) {\n                  data.compressQuality = value[0];\n                },\n              },\n            },\n          ],\n        },\n        {\n          title: \"事件\",\n          items: [\n            {\n              title: \"值变化\",\n              type: \"_event\",\n              options: {\n                outputId: \"onChange\",\n              },\n            },\n          ],\n        },\n      ];\n    },\n  },\n};\n"
              },
              {
