                            "content": "export default {\n  description: `按钮组件`,\n  editors: {\n    // \":root\": {\n    //   title: \"按钮\",\n    //   items: [\n    //     {\n    //       title: \"样式\",\n    //       type: \"style\",\n    //       options: [\"background\", \"font\", \"border\", \"padding\", \"margin\"],\n    //     },\n    //   ],\n    // },\n  },\n  docs: require(\"./Button.md\").default,\n};\n"
